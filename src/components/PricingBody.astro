---
/* Shared pricing body. Rendered by /pricing and /es/precios from the SAME
 * component and the SAME plan data, so the two languages cannot drift.
 * Everything is server-rendered at build time — no client i18n, no
 * ?lang= parameter, and therefore no untranslated flash. */
import { COPY, AMOUNTS, ROUTES, type Lang } from '../data/plans';

interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const t = COPY[lang];
const $ = AMOUNTS[lang];
const plusHref = ROUTES.plus[lang];
---
<main class="pricing">
  <div class="topglow" aria-hidden="true"></div>
  <div class="in">
    <div class="sub-top">
      <a class="iconbtn" href="/today" aria-label={t.back}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg></a>
      <span class="ttl">{t.planLabel}</span>
      <span class="iconbtn" style="visibility:hidden"></span>
    </div>

    <div class="pscroll">
      <div class="phero rise d1">
        <h1>{t.h1}</h1>
        <div class="pkick">{t.heroKicker}</div>
        <div class="psub">{t.sub}</div>
      </div>

      <div class="pcycle rise d2" role="radiogroup" aria-label={t.cycleAria}>
        <button type="button" class="pcy on" role="radio" aria-checked="true" data-cycle="m">{t.monthly}</button>
        <button type="button" class="pcy" role="radio" aria-checked="false" tabindex="-1" data-cycle="y">{t.annual} — {t.saveApprox}</button>
      </div>

      <div class="pcards" data-m-stagger>
        <section class="pcard m-rise">
          <div class="pc-hd">
            <div class="pc-nm">{t.freeName}</div>
            <div class="pc-head2">{t.freeHeading}</div>
            <div class="pc-pr"><span class="pc-amt">$0</span></div>
            <div class="pc-note">{t.freeSub}</div>
          </div>
          <div class="pc-inc">{t.freeIncludedLabel}</div>
          <ul class="pc-list">{t.freeFeatures.map((f) => <li>{f}</li>)}</ul>
          
          <div class="pc-cta">
            <a class="btn btn-ghost" href="/create-account">{t.freeCta}</a>
            <div class="pc-fine">{t.freeNote2}</div>
          </div>
        </section>

        <section class="pcard pc-plus m-rise">
          <div class="pc-tag">{t.plusName}</div>
            <div class="pc-best" hidden>{t.bestValue}</div>
          <div class="pc-hd">
            <div class="pc-nm">{t.plusName}</div>
            <div class="pc-head2">{t.plusHeading}</div>
            <div class="pc-found">{t.foundingLabel}</div>
            <div class="pc-pr">
              <span class="pc-amt" data-price-m={$.plus.monthly} data-price-y={$.plus.annual}>{$.plus.monthly}</span>
              <span class="pc-per" data-per-m={t.perMonth} data-per-y={t.perYear}>{t.perMonth}</span>
            </div>
            <!-- Annual detail. Savings are computed against 12 x the MONTHLY
                 price, never against the future standard price, so the figure
                 reflects a discount that actually exists. -->
            <div class="pc-annual" hidden>
              <div class="pc-eq">{t.perMonthBilledAnnually}</div>
              <div class="pc-save-amt">{t.saveVsMonthly}</div>
              <div class="pc-save-pct">{t.saveApprox}</div>
            </div>
            <div class="pc-note pc-mnote">{t.plusMonthlyNote}</div>
            <!-- Forward-looking, and labelled as such. This price has never been
                 charged, so presenting it as "was" would be a false discount. -->
            <div class="pc-future" data-future-m={t.futureStandardLabel} data-future-y={t.futureStandardLabelAnnual}>{t.futureStandardLabel}</div>
          </div>
          <div class="pc-chain">{t.plusChain}</div>
          <ul class="pc-list">{t.plusFeatures.map((f) => <li>{f}</li>)}</ul>
          <div class="pc-cta">
            <!-- Non-transactional until the coordinated launch. An enabled gold
                 button that took money nowhere would be worse than an honest one. -->
            <button type="button" class="btn btn-primary" disabled>{t.plusCta}</button>
            <div class="pc-fine">{t.plusFine}</div>
            <div class="pc-fine">{t.plusNote2}</div>
            <a class="pc-more" href={plusHref}>{t.plusSeePlans}</a>
          </div>
        </section>
      </div>

      <div class="lbl m-rise">{t.comingLabel}</div>
      <div class="pcoming m-rise"><p>{t.comingBody}</p></div>

      <div class="lbl m-rise">{t.moreLabel}</div>
      <div class="prows" data-m-stagger>
        <div class="prow m-rise">
          <div class="pr-m">
            <div class="pr-t">{t.familyName}</div>
            <div class="pr-h2">{t.familyHeading}</div>
            <div class="pr-planned pr-plannedprice"><span>{t.familyPlannedLabel}</span> {t.familyPlanned}</div>
            <div class="pr-planned">{t.familyIntro}</div>
            <div class="pr-inc">{t.familyPlannedLabel2}</div>
            <ul class="pr-list">{t.familyFeatures.map((f) => <li>{f}</li>)}</ul>
          </div>
          <div class="pr-r">
            <div class="pr-s">{t.comingSoon}</div>
          </div>
        </div>
        <div class="prow m-rise">
          <div class="pr-m">
            <div class="pr-t">{t.churchName}</div>
            <div class="pr-h2">{t.churchHeading}</div>
            <div class="pr-d">{t.churchIntro}</div>
            <div class="pr-planned pr-plannedprice">{t.churchPriceLabel}</div>
          </div>
          <div class="pr-r">
            <a class="pr-link" href="mailto:support@declareandbelieve.com?subject=Declare%20for%20our%20church">{t.churchCta}</a>
          </div>
        </div>
      </div>

      <!-- Compare plans. A real <table> with scope'd headers so a screen reader
           announces which plan a cell belongs to; it scrolls inside its own
           container so the page body never scrolls sideways on a phone. -->
      <h2 class="psec-h m-rise">{t.compareTitle}</h2>
      <p class="psec-lede m-rise">{t.compareLede}</p>
      <div class="ptable-wrap m-rise">
        <table class="ptable">
          <thead>
            <tr>
              <th scope="col">{t.compareCols.experience}</th>
              <th scope="col">{t.compareCols.free}</th>
              <th scope="col">{t.compareCols.plus}</th>
            </tr>
          </thead>
          <tbody>
            {t.compareRows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.free}</td>
                <td>{r.plus}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- No trial. Stated plainly because "free trial" is the thing people
           brace for, and the honest answer is the reassuring one. -->
      <section class="pnotrial m-rise">
        <div class="pnt-k">{t.noTrialTitle}</div>
        <h2 class="pnt-h">{t.noTrialLede}</h2>
        <p class="pnt-b">{t.noTrialBody}</p>
      </section>

      <!-- FAQ as native details/summary: keyboard operable and screen-reader
           announced without a line of JavaScript. -->
      <h2 class="psec-h m-rise">{t.faqTitle}</h2>
      <div class="pfaq m-rise">
        {t.faq.map((item) => (
          <details class="pfaq-i">
            <summary>{item.q}</summary>
            <div class="pfaq-a">{item.a.map((para) => <p>{para}</p>)}</div>
          </details>
        ))}
      </div>

      <section class="pcommit m-rise">
        <h2 class="pcom-h">{t.commitTitle}</h2>
        {t.commitBody.map((para) => <p>{para}</p>)}
      </section>

      <div class="pfoot m-rise">
        <p>{t.foot}</p>
        <p class="pfoot-store">{t.storefrontNote}</p>
        <p class="pfoot-l"><a href={plusHref}>{t.termsLink}</a></p>
      </div>
    </div>
  </div>
</main>

<script>
  /* Billing-interval toggle.
     Swaps only PRESENTATION. Every figure was computed at build time from
     src/data/pricing.ts, so nothing here divides or formats a price — the page
     cannot disagree with the source.

     Accessibility: the two controls are a radiogroup, so a screen reader
     announces which interval is selected rather than leaving it to colour
     alone. Arrow keys move between them, matching the radio pattern.

     It never initiates checkout. Selecting an interval is a display change. */
  const page = document.querySelector('.pricing');
  const btns = [...page.querySelectorAll('.pcy')];

  function setCycle(c, focus) {
    btns.forEach((b) => {
      const on = b.dataset.cycle === c;
      b.classList.toggle('on', on);
      b.setAttribute('aria-checked', on ? 'true' : 'false');
      b.tabIndex = on ? 0 : -1;
      if (on && focus) b.focus();
    });
    page.querySelectorAll('[data-price-m]').forEach((el) => {
      el.textContent = c === 'y' ? el.dataset.priceY : el.dataset.priceM;
    });
    page.querySelectorAll('[data-per-m]').forEach((el) => {
      el.textContent = c === 'y' ? el.dataset.perY : el.dataset.perM;
    });
    page.querySelectorAll('[data-future-m]').forEach((el) => {
      el.textContent = c === 'y' ? el.dataset.futureY : el.dataset.futureM;
    });
    // Annual-only detail: monthly equivalent and the two savings lines.
    page.querySelectorAll('.pc-annual').forEach((el) => { el.hidden = c !== 'y'; });
    page.querySelectorAll('.pc-best').forEach((el) => { el.hidden = c !== 'y'; });
    page.querySelectorAll('.pc-mnote').forEach((el) => { el.hidden = c === 'y'; });
  }

  btns.forEach((b, i) => {
    b.addEventListener('click', () => setCycle(b.dataset.cycle));
    b.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      const next = btns[(i + (e.key === 'ArrowRight' ? 1 : btns.length - 1)) % btns.length];
      setCycle(next.dataset.cycle, true);
    });
  });
  setCycle('m');
</script>

<style is:global>
  .pricing { position: relative; min-height: 100dvh; }
  .pricing .in { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; padding: 0 20px 120px; }
  .pricing .sub-top { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 12px 0 0; }
  .pricing .sub-top .ttl { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
  .pricing .iconbtn { width: 38px; height: 38px; border-radius: 50%; border: 0; background: transparent; color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .pricing .iconbtn svg { width: 20px; height: 20px; }
  .pricing .pscroll { padding-top: 8px; }
  .pricing .phero { text-align: center; padding: 18px 0 26px; }
  .pricing .phero h1 { font-family: 'Cormorant Garamond', serif; font-size: 34px; line-height: 1.15; color: var(--text); font-weight: 500; }
  .pricing .psub { font-size: 14px; line-height: 1.65; color: var(--muted); margin: 12px auto 0; max-width: 46ch; }
  .pricing .pcycle { display: flex; gap: 4px; padding: 4px; margin: 0 auto 22px; width: max-content; background: var(--field); border: 1px solid var(--line); border-radius: 100px; }
  /* 44px minimum touch target (WCAG 2.5.5). padding alone left it ~36px. */
  .pricing .pcy { font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600; color: var(--muted); background: none; border: 0; border-radius: 100px; padding: 0 20px; min-height: 44px; min-width: 44px; cursor: pointer; transition: color .25s, background .25s; }
  .pricing .pcy:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  .pricing .pcy.on { color: var(--ctatext); background: var(--cta); }
  .pricing .pcards { display: grid; gap: 14px; }
  @media (min-width: 720px) { .pricing .pcards { grid-template-columns: 1fr 1fr; align-items: start; } }
  .pricing .pcard { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 22px 20px; }
  .pricing .pc-plus { border-color: var(--gold); }
  .pricing .pc-tag { position: absolute; top: -10px; left: 20px; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #13211A; background: var(--gold); padding: 4px 10px; border-radius: 100px; }
  .pricing .pc-nm { font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .pricing .pc-pr { display: flex; align-items: baseline; gap: 4px; margin-top: 8px; }
  .pricing .pc-amt { font-family: 'Cormorant Garamond', serif; font-size: 42px; line-height: 1; color: var(--text); font-variant-numeric: tabular-nums; }
  .pricing .pc-per { font-size: 13px; color: var(--muted); }
  .pricing .pc-note { font-size: 12px; line-height: 1.5; color: var(--muted); margin-top: 8px; }
  .pricing .pc-note[hidden] { display: none; }
  .pricing .pc-save { color: var(--goldd); }
  .pricing .pc-chain { font-size: 13px; font-weight: 600; color: var(--text2); margin-top: 18px; }
  .pricing .pc-list { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 10px; }
  .pricing .pc-list li { position: relative; padding-left: 24px; font-size: 14px; line-height: 1.5; color: var(--text2); }
  .pricing .pc-list li::before { content: ''; position: absolute; left: 4px; top: 6px; width: 9px; height: 5px; border-left: 1.8px solid var(--gold); border-bottom: 1.8px solid var(--gold); transform: rotate(-45deg); }
  .pricing .pc-cta { margin-top: 20px; }
  .pricing .pc-cta .btn { width: 100%; }
  .pricing .pc-cta .btn[disabled] { opacity: .55; cursor: not-allowed; }
  .pricing .pc-fine { font-size: 11.5px; line-height: 1.5; color: var(--muted); text-align: center; margin-top: 9px; }
  .pricing .pc-more { display: block; text-align: center; margin-top: 12px; font-size: 13px; font-weight: 600; color: var(--goldd); }
  .pricing .lbl { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 34px 0 12px; }
  .pricing .pcoming { border: 1px dashed var(--line2); border-radius: 16px; padding: 16px 18px; }
  .pricing .pcoming p { font-size: 13.5px; line-height: 1.65; color: var(--muted); }
  .pricing .prows { display: grid; gap: 10px; }
  .pricing .prow { display: flex; align-items: center; gap: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px; }
  .pricing .pr-m { flex: 1; min-width: 0; }
  .pricing .pr-t { font-size: 15px; font-weight: 600; color: var(--text); }
  .pricing .pr-d { font-size: 12.5px; line-height: 1.5; color: var(--muted); margin-top: 3px; }
  .pricing .pr-r { flex: 0 0 auto; text-align: right; }
  .pricing .pr-p { font-size: 16px; color: var(--text); font-variant-numeric: tabular-nums; }
  .pricing .pr-per { font-size: 12px; color: var(--muted); }
  .pricing .pr-s { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--goldd); margin-top: 3px; }
  .pricing .pr-link { font-size: 13.5px; font-weight: 600; color: var(--goldd); }
  .pricing .pfoot { margin-top: 34px; text-align: center; }
  .pricing .pfoot p { font-size: 12.5px; line-height: 1.6; color: var(--muted); max-width: 42ch; margin: 0 auto; }
  .pricing .pfoot-l { margin-top: 12px; }
  .pricing .pfoot-l a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }

  /* ── founding-pricing presentation ── */
  .pricing .pc-found { font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--goldd); margin-top: 10px; }
  .pricing .pc-future { font-size: 11.5px; line-height: 1.5; color: var(--muted); margin-top: 10px; }
  .pricing .pc-annual[hidden], .pricing .pc-best[hidden], .pricing .pc-mnote[hidden] { display: none; }
  .pricing .pc-annual { margin-top: 10px; display: grid; gap: 3px; }
  .pricing .pc-eq { font-size: 12.5px; color: var(--text2); }
  /* Savings are stated in words, never signalled by colour alone. */
  .pricing .pc-save-amt, .pricing .pc-save-pct { font-size: 12.5px; color: var(--goldd); }
  .pricing .pc-best { position: absolute; top: -10px; right: 20px; font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text); background: var(--field); border: 1px solid var(--gold); padding: 3px 9px; border-radius: 100px; }
  .pricing .pfoot-store { font-size: 11.5px; color: var(--muted); margin-top: 10px; }
  /* A disabled control must read as unavailable, not merely look faded. */
  .pricing .pc-cta .btn[disabled] { pointer-events: none; }

  /* ── hero + card headings ── */
  .pricing .pkick { font-size: 13.5px; line-height: 1.6; color: var(--text2); margin: 10px auto 0; max-width: 44ch; }
  .pricing .pc-head2 { font-family: 'Cormorant Garamond', serif; font-size: 21px; line-height: 1.2; color: var(--text); margin-top: 6px; }
  .pricing .pc-inc { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: 18px; }
  .pricing .pr-h2 { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--text); margin-top: 2px; }
  .pricing .pr-planned { font-size: 12.5px; line-height: 1.55; color: var(--muted); margin-top: 6px; }
  .pricing .pr-plannedprice { color: var(--text2); }
  .pricing .pr-inc { font-size: 11.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-top: 12px; }
  .pricing .pr-list { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 7px; }
  .pricing .pr-list li { position: relative; padding-left: 20px; font-size: 13px; line-height: 1.5; color: var(--text2); }
  .pricing .pr-list li::before { content: ''; position: absolute; left: 3px; top: 8px; width: 5px; height: 5px; border-radius: 50%; background: var(--soft); }
  /* Family/Church rows stack now that they carry a heading and a feature list. */
  .pricing .prow { align-items: flex-start; flex-direction: column; gap: 10px; }
  .pricing .pr-r { text-align: left; }

  /* ── section headings ── */
  .pricing .psec-h { font-family: 'Cormorant Garamond', serif; font-size: 26px; color: var(--text); font-weight: 500; margin: 40px 0 6px; text-align: center; }
  .pricing .psec-lede { font-size: 13.5px; line-height: 1.6; color: var(--muted); text-align: center; max-width: 40ch; margin: 0 auto 16px; }

  /* ── compare table: scrolls inside its own container so the page body never
        scrolls sideways on a phone ── */
  .pricing .ptable-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
  .pricing .ptable { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 340px; }
  .pricing .ptable th, .pricing .ptable td { padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--line); }
  .pricing .ptable thead th { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .pricing .ptable thead th:not(:first-child), .pricing .ptable td { text-align: right; }
  .pricing .ptable tbody th { font-weight: 500; color: var(--text2); }
  .pricing .ptable td { color: var(--text); }
  .pricing .ptable tbody tr:last-child th, .pricing .ptable tbody tr:last-child td { border-bottom: 0; }

  /* ── no-trial + commitment ── */
  .pricing .pnotrial, .pricing .pcommit { margin-top: 40px; padding: 22px 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); text-align: center; }
  .pricing .pnt-k { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--goldd); }
  .pricing .pnt-h, .pricing .pcom-h { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: var(--text); font-weight: 500; margin-top: 8px; }
  .pricing .pnt-b, .pricing .pcommit p { font-size: 13.5px; line-height: 1.7; color: var(--muted); margin-top: 10px; max-width: 46ch; margin-left: auto; margin-right: auto; }

  /* ── FAQ: native details/summary — keyboard operable with no JavaScript ── */
  .pricing .pfaq { display: grid; gap: 8px; }
  .pricing .pfaq-i { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
  .pricing .pfaq-i summary { list-style: none; cursor: pointer; padding: 13px 16px; min-height: 44px; box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 14px; line-height: 1.4; font-weight: 600; color: var(--text); }
  .pricing .pfaq-i summary::-webkit-details-marker { display: none; }
  .pricing .pfaq-i summary::after { content: ''; flex: 0 0 auto; width: 8px; height: 8px; border-right: 1.8px solid var(--muted); border-bottom: 1.8px solid var(--muted); transform: rotate(45deg); transition: transform .25s ease; }
  .pricing .pfaq-i[open] summary::after { transform: rotate(-135deg); }
  .pricing .pfaq-i summary:focus-visible { outline: 2px solid var(--gold); outline-offset: -2px; border-radius: 12px; }
  .pricing .pfaq-a { padding: 0 16px 14px; }
  .pricing .pfaq-a p { font-size: 13.5px; line-height: 1.65; color: var(--muted); }
  .pricing .pfaq-a p + p { margin-top: 8px; }
  @media (prefers-reduced-motion: reduce) { .pricing .pfaq-i summary::after { transition: none; } }
</style>
