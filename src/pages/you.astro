    (function setVer(){ const el = document.getElementById('yVer'); if (el && RELEASES[0]) el.textContent = (esY() ? 'DECLARE · VERSIÓN ' : 'DECLARE · VERSION ') + RELEASES[0].v; })();
    function rlsTagClass(t: string): string { return 'yrls-tag ' + (t === 'New' ? 'is-new' : t === 'Fixed' ? 'is-fixed' : 'is-imp'); }
    // Gentle "something new here" cue: the What's-new card nudges only while the
    // newest release hasn't been opened on this device. Opening it rests the cue
    // until the next version ships.
    const NEWS_SEEN = 'declare-whatsnew-seen';
    (function () {
      try {
        const card = document.getElementById('yWhatsNew');
        if (card && localStorage.getItem(NEWS_SEEN) !== RELEASES[0].v) card.classList.add('has-news');
      } catch (e) {}
    })();
    function openWhatsNew() {
      try { localStorage.setItem(NEWS_SEEN, RELEASES[0].v); const c = document.getElementById('yWhatsNew'); if (c) c.classList.remove('has-news'); } catch (e) {}
      const sub = document.getElementById('yRlsSub'); if (sub) sub.textContent = esY() ? 'Todo lo que hemos lanzado últimamente, en lenguaje sencillo.' : 'Everything we have shipped lately, in plain language.';
      var _BADGE: Record<string, string> = { New:'Nuevo', Fixed:'Corregido', Improved:'Mejorado' };
      var _MON: Record<string, string> = { January:'enero',February:'febrero',March:'marzo',April:'abril',May:'mayo',June:'junio',July:'julio',August:'agosto',September:'septiembre',October:'octubre',November:'noviembre',December:'diciembre' };
      function rlsDate(d: string): string { return esY() ? String(d).replace(/([A-Za-z]+)\s+(\d{4})/, function(_: string, mo: string, y: string){ return (_MON[mo]||mo) + ' de ' + y; }) : d; }
      $('yRlsBody').innerHTML = RELEASES.map(function(r: { v: string; date: string; items: string[][] }){
        return '<div class="yrls-rel"><div class="yrls-vh"><span class="yrls-v">' + (esY() ? 'Versión ' : 'Version ') + r.v + '</span><span class="yrls-date">' + rlsDate(r.date) + '</span></div>'
          + r.items.map(function(it: string[]){ return '<div class="yrls-item"><span class="yrls-tagcol"><span class="' + rlsTagClass(it[0]) + '">' + ((esY() && _BADGE[it[0]]) ? _BADGE[it[0]] : it[0]) + '</span></span><span class="yrls-txt">' + (esY() && it[2] ? it[2] : it[1]) + '</span></div>'; }).join('')
          + '</div>';
      }).join('');
      $('yRlsModal').classList.add('open');
    }
    function closeWhatsNew() { $('yRlsModal').classList.remove('open'); }
    $('yWhatsNew') && $('yWhatsNew').addEventListener('click', openWhatsNew);
    $('yRlsX') && $('yRlsX').addEventListener('click', closeWhatsNew);
    $('yRlsBack') && $('yRlsBack').addEventListener('click', closeWhatsNew);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && $('yRlsModal') && $('yRlsModal').classList.contains('open')) closeWhatsNew(); });
    // footer "What's new" links land here with ?whatsnew=1 and open the log directly
    try { if (new URLSearchParams(location.search).get('whatsnew')) openWhatsNew(); } catch (e) {}

    /* ---------- church hub card reflects the saved church ---------- */
    function renderChurchHub() {
      $('hubChurchD').innerHTML = (signedInNow() && P.church)
        ? esc(P.church.name) + ' <span class="ybadge home">' + tY('you.homeBadge','Home') + '</span>'
        : tY('you.findChurchD','Discover a fellowship near you');
    }
    $('hubChurch').addEventListener('click', () => { (signedInNow() && P.church) ? openHomeChurch() : openFinder(); });

    /* ---------- real account session (Convex + Better Auth) ---------- */
    function renderAuth() {
      const signedIn = isConfigured() && isSignedIn();
      const u = signedIn ? currentUser() : null;
      // First sign-in mirrors the account's name onto this device so the rail
      // greets them right away. Only fills a blank name; never overwrites. On
      // sign-out the profile is cleared (see signOut), so the guest slate is blank.
      if (signedIn && u && u.firstName && !getProfile().name) P = setProfile({ name: u.firstName });
      $('yRole').textContent = signedIn ? ((u && u.email) || tY('you.roleSignedIn','Signed in')) : tY('you.roleGuest','Guest · not signed in');
      $('hubAuthD').textContent = signedIn ? (tY('you.signedInAs','Signed in as ') + ((u && u.email) || tY('you.you','you'))) : tY('you.signInKeep','Sign in to keep what God gives you');
      // Re-read the profile and re-render every personal surface so name, facts,
      // interests and the church hub reflect the current account/guest state.
      P = getProfile(); renderRail(); renderFacts(); renderChips(); renderChurchHub();
    }
    $('hubAuth').addEventListener('click', () => {
      if (!(isConfigured() && isSignedIn())) {
        // Julienne model: the account card opens right here
        openAuthModal({ mode: 'signin', onSuccess: () => { renderAuth(); toast(tY('you.welcomeBack','Welcome back.')); } });
        return;
      }
      const u: { email?: string } = currentUser() || {};
      modalKey = 'auth';
      $('ymTitle').textContent = tY('you.yourAccount','Your account');
      $('ymSub').textContent = tY('you.signedInAs','Signed in as ') + (u.email || tY('you.you','you')) + tY('you.accountSub2','. Your words and verses stay on this device for now.');
      $('ymBody').innerHTML = '<button class="btn btn-ghost" id="ymSignout" style="width:100%;margin-top:16px" data-i18n="you.signOut">Sign out</button>';
      try { window.I18N?.apply(); } catch (e) {}
      $('ymSave').style.display = 'none';
      const signout = document.getElementById('ymSignout');
      if (signout) signout.addEventListener('click', async () => {
        await signOut(); closeModal(); renderAuth(); toast(tY('you.signedOut','Signed out on this device.'));
      });
      openModal();
    });
    function tY(k: string, fb: string): string { try { return window.I18N ? window.I18N.t(k, fb) : fb; } catch(e){ return fb; } }
    function esY(): boolean { try { return !!(window.I18N && window.I18N.lang && window.I18N.lang() === 'es'); } catch(e){ return false; } }
    initAuth().then(renderAuth);
    onAuthChange(renderAuth);
    // in-app language toggle (Español | English) — persists + reloads to re-render everywhere
    (function(){
      const found = document.getElementById('langCtl'); if (!found) return;
      /* Bound explicitly: the guard above does not narrow inside a nested
         function declaration. */
      const ctl: HTMLElement = found;
      function paint(){ var l = (window.I18N?.lang() ?? 'en'); ctl.querySelectorAll<HTMLElement>('button').forEach(function(b){ b.classList.toggle('on', b.dataset.lang === l); }); }
      paint();
      // Repaint once everything has loaded and on any language change — the active
      // highlight must never show a stale language (module boot order is not a
      // guarantee that I18N was ready at first paint).
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', paint); else setTimeout(paint, 0);
      document.addEventListener('declare-lang', paint);
      ctl.addEventListener('click', function(e: Event){
        var b = closestFrom(e, 'button'); if (!b || !b.dataset.lang) return;
        var want = b.dataset.lang;
        if (window.I18N?.lang() === want) { paint(); return; }
        try {
          if (window.I18N) { window.I18N.setLang(want); }
          else { // engine not ready yet: never a dead click — write the choice directly
            document.cookie = 'declare-lang=' + want + ';path=/;max-age=31536000;samesite=lax';
            localStorage.setItem('declare-lang', want);
            localStorage.setItem('declare-lang-set', '1');
            localStorage.setItem('declare-lang-push', '1');
          }
        } catch(err){}
        location.reload();
      });
    })();

    /* ---------- church finder (Google Maps + Places, lazy) ---------- */
    let gmapsLoading: Promise<void> | null = null;
    let map: google.maps.Map | null = null;
    let places: google.maps.places.PlacesService | null = null;
    let markers: google.maps.Marker[] = [];
    const DARK_MAP = [
      { elementType: 'geometry', stylers: [{ color: '#10201a' }] },
      { elementType: 'labels.text.fill', stylers: [{ color: '#8fa399' }] },
      { elementType: 'labels.text.stroke', stylers: [{ color: '#0b110d' }] },
      { featureType: 'poi', stylers: [{ visibility: 'off' }] },
      { featureType: 'poi.place_of_worship', stylers: [{ visibility: 'on' }] },
      { featureType: 'road', elementType: 'geometry', stylers: [{ color: '#1c2d25' }] },
      { featureType: 'water', elementType: 'geometry', stylers: [{ color: '#0c1a22' }] },
      { featureType: 'transit', stylers: [{ visibility: 'off' }] },
    ];
    function loadGmaps(): Promise<void> {
      if (gmapsLoading) return gmapsLoading;
      gmapsLoading = new Promise<void>((resolve, reject) => {
        if (window.google && window.google.maps) { resolve(); return; }
        const s = document.createElement('script');
        s.src = 'https://maps.googleapis.com/maps/api/js?key=' + GMAPS_KEY + '&libraries=places&v=weekly';
        s.async = true; s.onload = () => resolve(); s.onerror = reject;
        document.head.appendChild(s);
      });
      return gmapsLoading;
    }
    function openFinder() {
      $('yFinder').classList.add('open');
      if (!GMAPS_KEY) {
        $('yfMissing').hidden = false;
        $('yfMap').style.display = 'none';
        $('yfLoc').style.display = 'none';
        const yfSearch = document.querySelector<HTMLElement>('.yf-search');
        if (yfSearch) yfSearch.style.display = 'none';
        return;
      }
      loadGmaps().then(initFinder).catch(() => toast('Maps couldn’t load — check the key restrictions.'));
    }
    $('yfClose').addEventListener('click', () => $('yFinder').classList.remove('open'));
    function initFinder(): void {
      if (map) return;
      const center = P.church && P.church.loc ? P.church.loc : { lat: 39.5, lng: -98.35 };
      const mapObj = new google.maps.Map($('yfMap'), {
        center, zoom: P.church && P.church.loc ? 12 : 4,
        styles: DARK_MAP, disableDefaultUI: true, zoomControl: true,
      });
      map = mapObj;
      places = new google.maps.places.PlacesService(mapObj);
      /* Autocomplete binds to the text field, which must be an <input>. */
      const ac = new google.maps.places.Autocomplete($as('yfInput', HTMLInputElement, 'an <input>'), { fields: ['geometry', 'name', 'formatted_address', 'place_id', 'types'] });
      ac.addListener('place_changed', () => {
        const p = ac.getPlace();
        if (!p) return;
        // Enter pressed on raw text (no suggestion picked) -> full-text church
        // search, so "pentecostal churches" or "Fuente iglesia" just works
        if (!p.geometry) { searchText(p.name || ''); return; }
        if ((p.types || []).indexOf('church') >= 0 || (p.types || []).indexOf('place_of_worship') >= 0) {
          renderChurches([{ name: p.name, vicinity: p.formatted_address, place_id: p.place_id, geometry: p.geometry }]);
          const at = p.geometry.location;
          if (map && at) { map.setCenter(at); map.setZoom(14); }
        } else if (p.geometry.location) {
          searchNear(p.geometry.location);
        }
      });
      $('yfLoc').addEventListener('click', () => {
        if (!navigator.geolocation) return;
        navigator.geolocation.getCurrentPosition(
          (pos) => searchNear(new google.maps.LatLng(pos.coords.latitude, pos.coords.longitude)),
          () => toast(esY() ? 'Ubicación no disponible — busca una ciudad.' : 'Location unavailable — search a city instead.')
        );
      });
    }
    function searchNear(loc: google.maps.LatLng | google.maps.LatLngLiteral): void {
      if (!map || !places) return; // only reachable after initFinder()
      map.setCenter(loc); map.setZoom(12);
      $('yfList').innerHTML = '<div class="yf-note">' + (esY() ? 'Buscando iglesias cerca…' : 'Looking for churches nearby…') + '</div>';
      places.nearbySearch({ location: loc, radius: 9000, type: 'church' }, (res, status) => {
        if (status !== google.maps.places.PlacesServiceStatus.OK || !res || !res.length) {
          $('yfList').innerHTML = '<div class="yf-note">' + (esY() ? 'No se encontraron iglesias aquí — amplía la búsqueda.' : 'No churches found here — try a wider search.') + '</div>';
          return;
        }
        renderChurches(res.slice(0, 10));
      });
    }
    /* free-text search: "pentecostal churches", "Fuente iglesia",
       "Fountain church in New Jersey" — Places textSearch understands all of
       these natively. Biased to the current map view so bare denominations
       ("baptist") land near the user, not across the country. */
    function searchText(q: string): void {
      q = (q || '').trim();
      if (q.length < 2) return;
      $('yfList').innerHTML = '<div class="yf-note">' + (esY() ? 'Buscando iglesias…' : 'Searching churches…') + '</div>';
      const churchy = /church|iglesia|chapel|capilla|temple|templo|ministr|fellowship|assembl|asamblea|tabernac|cathedral|catedral|parish|parroquia|congrega/i.test(q);
      const req: google.maps.places.TextSearchRequest = { query: churchy ? q : q + ' church' };
      if (map) { const c = map.getCenter(); if (c) { req.location = c; req.radius = 30000; } }
      if (!places) return; // only reachable after initFinder()
      places.textSearch(req, (res, status) => {
        if (status !== google.maps.places.PlacesServiceStatus.OK || !res || !res.length) {
          $('yfList').innerHTML = '<div class="yf-note">' + (esY() ? ('Nada encontrado para “' + esc(q) + '” — prueba con una ciudad o código postal.') : ('Nothing found for “' + esc(q) + '” — try adding a city or zip.')) + '</div>';
          return;
        }
        renderChurches(res.slice(0, 10));
      });
    }
    function ratingHtml(c: PlaceLike): string {
      if (!c.rating) return '';
      return '<span class="star">★</span> ' + Number(c.rating).toFixed(1)
        + (c.user_ratings_total ? ' <span class="dim">(' + c.user_ratings_total + ')</span>' : '');
    }
    function setChurch(c: PlaceLike): void {
      // Searching for churches is open to everyone; SAVING one as "My church"
      // is a kept thing — it needs an account. The card opens right here and
      // saves the moment they're in.
      if (isConfigured() && !isSignedIn()) {
        openAuthModal({ mode: 'signup', message: esY() ? 'Crea una cuenta gratis para fijar tu iglesia base.' : 'Create a free account to set your home church.', onSuccess: () => doSetChurch(c) });
        return;
      }
      doSetChurch(c);
    }
    function doSetChurch(c: PlaceLike): void {
      /* A Places result always carries geometry.location together; reading
         them as one is the same test the old `c.geometry ?` made, minus the
         throw if a result ever arrived with geometry but no location. */
      const at = c.geometry && c.geometry.location;
      const loc = at ? { lat: at.lat(), lng: at.lng() } : null;
      P = setProfile({ church: { name: c.name, address: c.vicinity || c.formatted_address || '', placeId: c.place_id || '', loc } });
      toast('“' + c.name + '” ' + (esY() ? 'es tu iglesia base.' : 'is your home church.'));
      renderFacts(); renderChurchHub();
      closeDetail();
      $('yFinder').classList.remove('open');
    }
    function renderChurches(list: PlaceLike[]): void {
      markers.forEach((m) => m.setMap(null)); markers = [];
      const bounds = new google.maps.LatLngBounds();
      list.forEach((c) => {
        const at = c.geometry && c.geometry.location;
        if (!at) return;
        const mk = new google.maps.Marker({ map, position: at, title: c.name });
        mk.addListener('click', () => openDetail(c));
        markers.push(mk); bounds.extend(at);
      });
      if (list.length > 1 && map) map.fitBounds(bounds, 48);
      $('yfList').innerHTML = list.map((c: PlaceLike, i: number) => {
        const r = ratingHtml(c);
        return '<div class="yf-row" style="animation-delay:' + (i * 40) + 'ms">'
          + '<button class="yf-m" data-d="' + i + '"><span class="yf-n">' + esc(c.name) + '</span><span class="yf-a">' + esc(c.vicinity || c.formatted_address || '') + '</span>'
          + (r ? '<span class="yf-r">' + r + '</span>' : '') + '</button>'
          + '<button class="yf-set" data-i="' + i + '">' + (esY() ? 'Fijar como mi iglesia' : 'Set as my church') + '</button></div>';
      }).join('');
      $('yfList').querySelectorAll<HTMLElement>('.yf-m').forEach((b) => b.addEventListener('click', () => openDetail(list[Number(b.dataset.d)])));
      $('yfList').querySelectorAll<HTMLElement>('.yf-set').forEach((b) => b.addEventListener('click', () => setChurch(list[Number(b.dataset.i)])));
    }

    /* ---------- church detail sheet (tap a row or a map pin) ---------- */
    const DICONS = {
      phone: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2z"/></svg>',
      globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
      pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="2.6"/></svg>',
    };
    let detailPlace: PlaceLike | null = null, detailHome = false;
    function metaLine(c: PlaceLike): string {
      const bits: string[] = [];
      const r = ratingHtml(c);
      if (r) bits.push(r);
      let open: boolean | undefined | null = null;
      try { if (c.opening_hours && typeof c.opening_hours.isOpen === 'function') open = c.opening_hours.isOpen(); } catch (e) {}
      if (open === true) bits.push('<span class="ok">Open now</span>');
      else if (open === false) bits.push('<span class="dim">Closed now</span>');
      return bits.join('<span class="sep">·</span>');
    }
    function closeDetail() { $('yfDetail').classList.remove('open'); detailPlace = null; }
    $('yfdBack').addEventListener('click', closeDetail);
    $('yfdX').addEventListener('click', closeDetail);
    $('yfdSet').addEventListener('click', () => {
      if (detailHome) { closeDetail(); openFinder(); }
      else if (detailPlace) setChurch(detailPlace);
    });
    function llOf(c: PlaceLike) {
      if (c.geometry && c.geometry.location) return { lat: c.geometry.location.lat(), lng: c.geometry.location.lng() };
      return c.loc || null;
    }
    function gmapsDir(c: PlaceLike): string {
      return 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(c.formatted_address || c.name || '')
        + (c.place_id ? '&destination_place_id=' + encodeURIComponent(c.place_id) : '');
    }
    function chipA(label: string, href: string, icon: string): string {
      return '<a class="yfd-act" href="' + esc(href) + '" target="_blank" rel="noopener">' + icon + label + '</a>';
    }
    /* plain links — the phone hands each one to the installed app */
    function navActs(c: PlaceLike): string {
      const dest = encodeURIComponent(c.formatted_address || c.name || '');
      const ll = llOf(c);
      return chipA('Google Maps', gmapsDir(c), DICONS.pin)
        + chipA('Apple Maps', 'https://maps.apple.com/?daddr=' + dest, DICONS.pin)
        + chipA('Waze', ll ? 'https://waze.com/ul?ll=' + ll.lat + ',' + ll.lng + '&navigate=yes' : 'https://waze.com/ul?q=' + dest, DICONS.pin);
    }
    function paintActions(c: PlaceLike, d: PlaceLike | null): void {
      let acts = '';
      if (d && d.formatted_phone_number) acts += '<a class="yfd-act" href="tel:' + esc(d.formatted_phone_number.replace(/[^+\d]/g, '')) + '">' + DICONS.phone + 'Call</a>';
      if (d && d.website) acts += chipA('Website', d.website, DICONS.globe);
      acts += detailHome ? navActs(c) : chipA('Directions', gmapsDir(c), DICONS.pin);
      $('yfdActions').innerHTML = acts;
    }
    /* `home` is optional: omitting it means this is a search RESULT rather
       than the saved home church — see `!!home` and `if (home)` below. */
    function openDetail(c: PlaceLike, home?: boolean) {
      detailPlace = c; detailHome = !!home;
      // paint instantly from what we already know, then enrich from Google
      $('yfdName').innerHTML = esc(c.name || '') + (home ? ' <span class="ybadge home">Home</span>' : '');
      $('yfdAddr').textContent = c.vicinity || c.formatted_address || '';
      $as('yfdAddr', HTMLAnchorElement, 'an <a>').href = gmapsDir(c);
      $('yfdMeta').innerHTML = metaLine(c);
      $('yfdHours').innerHTML = '';
      if (home) paintActions(c, null);
      else $('yfdActions').innerHTML = c.place_id ? '<div class="yf-note">Getting details…</div>' : '';
      $('yfdSet').textContent = home ? 'Search for another church' : 'Set as my church';
      $('yfdSet').classList.toggle('alt', !!home);
      $('yfdPhoto').hidden = true; $('yfdPhoto').style.backgroundImage = '';
      $('yfDetail').classList.add('open');
      if (!c.place_id || !places) { if (!home) $('yfdActions').innerHTML = ''; return; }
      places.getDetails({
        placeId: c.place_id,
        fields: ['name', 'formatted_address', 'formatted_phone_number', 'website', 'opening_hours', 'utc_offset_minutes', 'rating', 'user_ratings_total', 'photos', 'geometry'],
      }, (d, status) => {
        if (detailPlace !== c) return; // user moved on
        if (status !== google.maps.places.PlacesServiceStatus.OK || !d) { if (!detailHome) $('yfdActions').innerHTML = ''; return; }
        // keep the richer record so "Set as my church" saves the full address
        detailPlace = Object.assign({}, c, { name: d.name || c.name, formatted_address: d.formatted_address || c.formatted_address, geometry: d.geometry || c.geometry });
        $('yfdName').innerHTML = esc(detailPlace.name) + (detailHome ? ' <span class="ybadge home">Home</span>' : '');
        if (d.formatted_address) $('yfdAddr').textContent = d.formatted_address;
        $as('yfdAddr', HTMLAnchorElement, 'an <a>').href = gmapsDir(detailPlace);
        $('yfdMeta').innerHTML = metaLine(d);
        if (d.photos && d.photos.length) {
          $('yfdPhoto').style.backgroundImage = 'url("' + d.photos[0].getUrl({ maxWidth: 1000, maxHeight: 560 }) + '")';
          $('yfdPhoto').hidden = false;
        }
        if (d.opening_hours && d.opening_hours.weekday_text) {
          const today = (new Date().getDay() + 6) % 7; // weekday_text starts Monday
          $('yfdHours').innerHTML = '<details class="yfd-hrs"><summary>' + esc(d.opening_hours.weekday_text[today]) + '</summary>'
            + d.opening_hours.weekday_text.map((l, i) => '<div class="' + (i === today ? 'on' : '') + '">' + esc(l) + '</div>').join('') + '</details>';
        }
        paintActions(detailPlace, d);
      });
    }
    /* "My church" -> the saved church's own card. Opens instantly from the
       device-local record, then Google fills in photo/hours/phone. */
    function openHomeChurch() {
      const hc = P.church;
      if (!hc) { openFinder(); return; }
      const c = { name: hc.name, formatted_address: hc.address, place_id: hc.placeId || '', loc: hc.loc || null };
      if (!GMAPS_KEY) { openDetail(c, true); return; }
      loadGmaps().then(() => {
        // Places works without the finder's map — a detached node is enough
        if (!places) places = new google.maps.places.PlacesService(document.createElement('div'));
        openDetail(c, true);
      }).catch(() => openDetail(c, true));
    }

    /* ---------- init ---------- */
    renderRail(); renderFacts(); renderChips(); renderChurchHub();
    // refresh stats when the account's Vault syncs in from Convex
    onChange(renderRail);
    // refresh the whole profile (name, church, interests) when it syncs in
    onAccountSync(() => { P = getProfile(); renderRail(); renderFacts(); renderChips(); renderChurchHub(); });

    /* ── Plan & billing ────────────────────────────────────────────────────
       Renders ONE state from the shared helper in plan-display.js. The states
       are deliberately distinct, because the ways they can be got wrong are the
       ways that matter: telling a cancelled subscriber their plan renews,
       telling a failing card it is Active, or telling a paying subscriber they
       are on Free because a read happened to fail.

       Reads getMyEntitlements only. No Stripe id, no localStorage, no URL. */
    type PbEls = {
      card: HTMLElement; nm: HTMLElement; meta: HTMLElement; state: HTMLElement;
      list: HTMLElement; msg: HTMLElement; acts: HTMLElement; badge: HTMLElement | null;
    };
    /* Resolved once, with a single guard, so every later use is non-null. */
    function pbEls(): PbEls | null {
      const card = document.getElementById('plan-billing');
      const nm = document.getElementById('pbTitle');
      const meta = document.getElementById('pbMeta');
      const state = document.getElementById('pbState');
      const list = document.getElementById('pbList');
      const msg = document.getElementById('pbMsg');
      const acts = document.getElementById('pbActs');
      if (!card || !nm || !meta || !state || !list || !msg || !acts) return null;
      return { card, nm, meta, state, list, msg, acts, badge: document.getElementById('yPlusBadge') };
    }

    /* I18N.t already falls back to its second argument. */
    const pbT = (k: string, fallback: string): string =>
      window.I18N ? window.I18N.t(k, fallback) : fallback;

    const PB_FALLBACK: Record<string, string> = {
      'plan.plusName': 'Declare Plus',
      'plan.freeName': 'Free plan',
      'plan.loadingName': 'Loading your plan',
      'plan.stateActive': 'ACTIVE',
      'plan.stateCancelling': 'ENDING',
      'plan.stateAttention': 'NEEDS ATTENTION',
      'plan.stateAmbiguous': 'NEEDS REVIEW',
      'plan.stateFree': 'FREE',
      'plan.monthly': 'Monthly plan',
      'plan.annual': 'Annual plan',
      'plan.renews': 'Renews',
      'plan.cancels': 'Cancels',
      'plan.manage': 'Manage billing',
      'plan.upgrade': 'Upgrade to Plus',
      'plan.retry': 'Try again',
      'plan.unavailableMsg': 'We could not load your plan right now.',
      'plan.cancellingMsg': 'Your Plus access remains available until then.',
      'plan.attentionMsg': 'Something about your payment needs a second look. You still have access while we sort it out.',
      'plan.ambiguousMsg': 'This account looks like it is being billed in more than one place. Open billing to review it, or contact support and we will sort it out.',
      'plan.b1': 'Unlimited Gentle Guidance',
      'plan.b2': 'Unlimited Journeys',
      'plan.b3': 'Unlimited active Journeys',
      'plan.portalErr': 'We could not open billing just now. Please try again.',
      'plan.noSub': 'There is no subscription on this account yet.',
      'plan.freeGuidance': 'Gentle Guidance left today',
      'plan.freeSlots': 'active Journey slots left',
    };
    const pbTx = (k: string): string => pbT(k, PB_FALLBACK[k] || '');

    function pbButton(label: string, onClick: (b: HTMLButtonElement) => void, variant: string): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'pb-btn ' + variant;
      b.textContent = label;
      b.addEventListener('click', () => onClick(b));
      return b;
    }
    function pbLink(label: string, href: string): HTMLAnchorElement {
      const a = document.createElement('a');
      a.className = 'pb-btn pb-primary';
      a.href = href;
      a.textContent = label;
      return a;
    }

    /* Single-flight and click-only. Disabled the moment it is pressed and left
       disabled while the request is in flight, so a double tap cannot mint two
       Portal sessions. Sends nothing — see openBillingPortal(). */
    let pbPortalBusy = false;
    async function pbManageBilling(btn: HTMLButtonElement): Promise<void> {
      if (pbPortalBusy) return;
      pbPortalBusy = true;
      btn.disabled = true;
      const els = pbEls();
      try {
        const res = await openBillingPortal();
        if (res && res.url) { window.location.href = res.url; return; }
        if (els) {
          els.msg.textContent = res && res.error === 'no-subscription'
            ? pbTx('plan.noSub') : pbTx('plan.portalErr');
          els.msg.hidden = false;
        }
      } catch (e) {
        if (els) { els.msg.textContent = pbTx('plan.portalErr'); els.msg.hidden = false; }
      }
      pbPortalBusy = false;
      btn.disabled = false;
    }

    function pbRender(ent: any, opts?: { loading?: boolean }): void {
      const els = pbEls();
      if (!els) return;
      const state: string = planState(ent, opts);
      const lang: string = window.I18N ? window.I18N.lang() : 'en';

      els.card.setAttribute('data-plan-state', state);
      els.card.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');

      /* Badge: identity only, and never before loading completes. */
      if (els.badge) els.badge.hidden = !showsPlusBadge(state);

      els.nm.textContent = state === 'loading'
        ? pbTx('plan.loadingName') : pbTx(planNameKey(state));

      /* Status chip. Absent while loading, so nothing claims a state we do not
         have yet. A WORD, never colour alone. */
      const stateKey = STATE_LABEL_KEYS[state];
      if (stateKey && state !== 'loading' && state !== 'guest') {
        els.state.textContent = pbTx(stateKey);
        els.state.hidden = false;
      } else { els.state.hidden = true; }

      /* Cadence and the date. The word in front of the date comes from the
         shared helper, so a scheduled cancellation can never read "Renews".
         No date is shown when we do not have one. */
      const bits: string[] = [];
      const ck = cadenceKey(ent);
      if (ck && state.indexOf('plus-') === 0) bits.push(pbTx(ck));
      const pk = periodLabelKey(state);
      const when = formatPeriodEnd(ent && ent.periodEndAt, lang);
      if (pk && when) bits.push(pbTx(pk) + ' ' + when);
      if (bits.length) { els.meta.textContent = bits.join(' \u00b7 '); els.meta.hidden = false; }
      else { els.meta.hidden = true; }

      /* Benefits, or the free plan's real remaining allowance. */
      els.list.innerHTML = '';
      if (state.indexOf('plus-') === 0) {
        for (const k of ['plan.b1', 'plan.b2', 'plan.b3']) {
          const li = document.createElement('li'); li.textContent = pbTx(k); els.list.appendChild(li);
        }
        els.list.hidden = false;
      } else if (state === 'free' && ent && ent.remaining) {
        const r = ent.remaining;
        const rows: string[] = [];
        if (typeof r.gentleGuidanceToday === 'number') {
          rows.push(r.gentleGuidanceToday + ' ' + pbTx('plan.freeGuidance'));
        }
        if (typeof r.activeJourneySlots === 'number') {
          rows.push(r.activeJourneySlots + ' ' + pbTx('plan.freeSlots'));
        }
        for (const text of rows) {
          const li = document.createElement('li'); li.textContent = text; els.list.appendChild(li);
        }
        els.list.hidden = rows.length === 0;
      } else { els.list.hidden = true; }

      /* Message line. */
      const MSG: Record<string, string> = {
        'plus-cancelling': 'plan.cancellingMsg',
        'plus-attention': 'plan.attentionMsg',
        'plus-ambiguous': 'plan.ambiguousMsg',
        unavailable: 'plan.unavailableMsg',
      };
      const msgKey = MSG[state];
      if (msgKey) { els.msg.textContent = pbTx(msgKey); els.msg.hidden = false; }
      else { els.msg.hidden = true; }

      /* Actions. */
      els.acts.innerHTML = '';
      if (showsManageBilling(state)) {
        els.acts.appendChild(pbButton(pbTx('plan.manage'), pbManageBilling, 'pb-primary'));
      } else if (state === 'free' || state === 'guest') {
        els.acts.appendChild(pbLink(pbTx('plan.upgrade'), '/pricing'));
      } else if (state === 'unavailable') {
        els.acts.appendChild(pbButton(pbTx('plan.retry'), () => { pbLoad(); }, 'pb-ghost'));
      }
    }

    async function pbLoad(): Promise<void> {
      /* Loading never renders Free — that is the bug this guards against. */
      pbRender(null, { loading: true });
      let ent: any = null;
      try { ent = await myEntitlements(); } catch (e) { ent = null; }
      pbRender(ent);
    }
    pbLoad();
    try { onAuthChange(() => { pbLoad(); }); } catch (e) {}

  
    /* ── Your Formation ────────────────────────────────────────────────────
       Built ONLY from data the app already holds:
         db_active_journey   which Journey is growing   -> /journey
         db_journeys_done    rooted Journeys            -> /journey
         vault listItems()   saved verses and words     -> /vault
       Every destination is a route that exists today. Nothing here counts
       streaks, scores, XP or achievements, and nothing says "you missed a
       day" — this is for revisiting, not for scoring a walk with God.

       Where a real number exists it is shown. Where one does not, the card
       carries an invitation instead of an invented statistic. */
    function yfRead(key: string): any {
      try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : null; }
      catch (e) { return null; }
    }

    function yfRender() {
      const host = document.getElementById('yFormation');
      if (!host) return;
      const t = (k: string, fb: string): string => (window.I18N ? window.I18N.t(k, fb) : fb);

      /* Active Journey. The stored shape is {id, day, ...} or a null tombstone. */
      const act = yfRead('db_active_journey');
      const activeId = act && typeof act === 'object' && act.id ? String(act.id) : null;
      const activeDay = act && typeof act.day === 'number' ? act.day : null;

      /* Rooted Journeys — a union of ids, so its length is a real count. */
      const done = yfRead('db_journeys_done');
      const doneCount = Array.isArray(done) ? done.length : 0;

      /* Saved truths, from the vault the user can already open. */
      let savedCount = 0;
      try { savedCount = listItems().length; } catch (e) { savedCount = 0; }

      const cards = [];

      cards.push({
        label: t('you.formWalking', 'What you are walking through'),
        value: activeId
          ? (activeDay ? t('you.formDay', 'Day') + ' ' + activeDay : t('you.formInProgress', 'In progress'))
          : t('you.formBegin', 'Begin a Journey'),
        note: activeId
          ? t('you.formContinue', 'Continue where you left off')
          : t('you.formBeginD', 'Walk through what you are carrying'),
        href: '/journey',
      });

      cards.push({
        label: t('you.formTruths', 'Truths you are carrying'),
        value: savedCount > 0 ? String(savedCount) : t('you.formSaveFirst', 'Nothing saved yet'),
        note: savedCount > 0
          ? t('you.formTruthsD', 'Verses and words you kept')
          : t('you.formTruthsEmpty', 'Keep what God gives you'),
        href: '/vault',
      });

      cards.push({
        label: t('you.formFruit', 'Fruit from your Journeys'),
        value: doneCount > 0 ? String(doneCount) : t('you.formFruitNone', 'Not yet'),
        note: doneCount > 0
          ? t('you.formFruitD', 'Journeys you have rooted')
          : t('you.formFruitEmpty', 'Finish a Journey to see it here'),
        href: '/journey',
      });

      host.innerHTML = '';
      for (const c of cards) {
        const a = document.createElement('a');
        a.className = 'yfcard';
        a.href = c.href;
        const l = document.createElement('span'); l.className = 'yf-l'; l.textContent = c.label;
        const v = document.createElement('span'); v.className = 'yf-v serif'; v.textContent = c.value;
        const n = document.createElement('span'); n.className = 'yf-n'; n.textContent = c.note;
        a.append(l, v, n);
        host.appendChild(a);
      }
    }
    yfRender();
    try { onAccountSync(() => yfRender()); } catch (e) {}

    /* ── Sign out ──────────────────────────────────────────────────────────
       A real row for a real action, shown only when there IS a session to end.
       The existing modal path still works; this simply stops sign-out being
       buried two taps deep. */
    (function wireSignOut() {
      const btn = document.getElementById('ySignOut');
      if (!(btn instanceof HTMLButtonElement)) return;
      const sync = () => { btn.hidden = !(isConfigured() && isSignedIn()); };
      sync();
      try { onAuthChange(sync); } catch (e) {}
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try { await signOut(); } catch (e) {}
        btn.disabled = false;
        sync();
        try { renderAuth(); } catch (e) {}
        try { toast(tY('you.signedOut', 'Signed out on this device.')); } catch (e) {}
      });
    })();

  </script>

