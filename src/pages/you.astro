    @media (hover: hover) { .you .yhubcard:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--gold) 32%, var(--line)); box-shadow: 0 24px 50px -22px rgba(0, 0, 0, .6); } }
    .you .yh-ic { position: relative; width: 38px; height: 38px; border-radius: 12px; background: var(--field); display: flex; align-items: center; justify-content: center; color: var(--goldd); margin-bottom: 12px; }
