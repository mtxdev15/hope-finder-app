---
// /you — the profile. REDESIGNED on the Airbnb account-profile model (profile
// rail + confirmed-info card + icon-fact grid with modal editors + interest
// chips + clean hub cards) wearing the Declare design system, with unseen-grade
// motion. Everything editable is REAL and device-local (profile-store.js,
// 'declare-profile-v1'); stats are computed from the actual Vault/highlights.
// Accounts/sign-in remain honestly "coming soon". "Find a church" is live via
// Google Maps + Places when PUBLIC_GMAPS_KEY exists (.env, gitignored,
// referrer-restricted) and degrades gracefully without it.
import DeclareLayout from '../layouts/DeclareLayout.astro';
import RateReview from '../components/RateReview.astro';
const GMAPS_KEY = import.meta.env.PUBLIC_GMAPS_KEY || '';
---
<DeclareLayout
  noindex
  title="Declare — You"
  description="Your Declare profile and settings."
  activeTab="you"
>
  <main class="you">
    <div class="topglow" aria-hidden="true"></div>
    <div class="you-col">

      {/* ── Account experience, in a deliberate order ─────────────────────
          1 identity · 2 plan · 3 formation · 4 account · 5 experience
          6 privacy & support · 7 mobile app · 8 sign out

          A subscriber must see who they are and what they hold BEFORE any
          secondary setting. The old two-column rail buried the plan beside the
          profile; a single centred column keeps the reading order and the
          visual order the same on every width, which is also what makes the
          mobile stack correct for free. */}
      <div class="yflow">

        {/* ── 1. Identity ─────────────────────────────────────────────── */}
        <section class="ysec yident m-rise" aria-labelledby="yName">
          <div class="yav-wrap">
            <button class="yav" id="yAvatar" type="button" aria-label="Add or change your photo" data-i18n-aria="you.photoAria"><span id="yAvText" class="serif">✝</span></button>
            <span class="yav-cam" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="3.5"/></svg></span>
          </div>
          <input type="file" id="yAvFile" accept="image/*" hidden />
          <button type="button" class="yav-remove" id="yAvRemove" hidden>Remove photo</button>
          <div class="yid-txt">
            <div class="yid-line">
              <h1 class="yname serif" id="yName">Friend</h1>
              {/* MEMBERSHIP identity, not billing health. Deliberately NOT gold:
                  gold stays a brand colour, but it must not be what says
                  "this account pays". PLUS identifies membership; ACTIVE,
                  Cancels and Payment needs attention live in the plan card. */}
              <span class="ybadge" id="yPlusBadge" hidden data-i18n-aria="you.plusBadgeAria"
                    aria-label="Declare Plus subscriber">PLUS</span>
            </div>
            <div class="yrole" id="yRole" data-i18n="you.roleGuest">Guest &middot; not signed in</div>
            <div class="ystat"><b id="yDays">1</b><span id="yDaysLbl" data-i18n="you.dayWith">day with Declare</span></div>
          </div>
        </section>

        {/* ── 2. Plan & billing ───────────────────────────────────────── */}
        <section class="ysec" aria-labelledby="yPlanH">
          <h2 class="ysec-h serif" id="yPlanH" data-i18n="you.planBillingH">Plan &amp; billing</h2>
          <div class="pbcard m-rise" id="plan-billing" aria-labelledby="pbTitle" aria-busy="true">
            <div class="pb-top">
              <div class="pb-id">
                <div class="pb-nm serif" id="pbTitle" data-i18n="plan.loadingName">Loading your plan</div>
                <div class="pb-meta" id="pbMeta" hidden></div>
              </div>
              <span class="pb-state" id="pbState" hidden></span>
            </div>
            <ul class="pb-list" id="pbList" hidden></ul>
            <p class="pb-msg" id="pbMsg" role="status" hidden></p>
            <div class="pb-acts" id="pbActs"></div>
          </div>
        </section>

        {/* ── 3. Your Formation ───────────────────────────────────────────
            The Declare-specific section. Reflective, never gamified: no
            streaks, no scores, no achievements, no "you missed a day". Every
            item is built from data the app ALREADY holds and links only to a
            route that already exists. Where a real number exists it is shown;
            where one does not, the card carries an invitation instead of an
            invented statistic. */}
        <section class="ysec" aria-labelledby="yFormH">
          <h2 class="ysec-h serif" id="yFormH" data-i18n="you.formationH">Your Formation</h2>
          <p class="ysec-d" data-i18n="you.formationD">Revisit what you are walking through and the truths you are carrying.</p>
          <div class="yform" id="yFormation"></div>
        </section>

        {/* ── 4. Account ──────────────────────────────────────────────── */}
        <section class="ysec" aria-labelledby="yAccH">
          <h2 class="ysec-h serif" id="yAccH" data-i18n="you.accountH">Account</h2>
          <p class="ysec-d" data-i18n="you.aboutYouSub">What you share here stays on this device — it simply makes Declare feel like yours.</p>
          <div class="yfacts m-rise" id="yFacts"></div>
          <div class="ychips-wrap m-rise">
            <div class="ylbl" data-i18n="you.askMeAbout">Ask me about</div>
            <div class="ychips" id="yChips"></div>
          </div>
          <div class="yrows m-rise" id="yHub">
            <button class="yrow" id="hubAuth">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.signSecurity">Sign-in &amp; security</span>
                <span class="yrow-d" id="hubAuthD" data-i18n="you.signInKeep">Sign in to keep what God gives you</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </button>
            <a class="yrow" href="#plan-billing">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.planBillingH">Plan &amp; billing</span>
                <span class="yrow-d" data-i18n="you.planRowD">See what you hold and manage billing</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </a>
            <a class="yrow" href="/pricing">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.plans">Plans</span>
                <span class="yrow-d" data-i18n="you.plansD">What’s free, and what Plus adds</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </a>
          </div>
        </section>

        {/* ── 5. Experience ───────────────────────────────────────────── */}
        <section class="ysec" aria-labelledby="yExpH">
          <h2 class="ysec-h serif" id="yExpH" data-i18n="you.experienceH">Experience</h2>
          <div class="yrows m-rise">
            <div class="yrow yrow-static">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.appearance">Appearance</span>
                <span class="yrow-d" data-i18n="you.appearanceD">Dark is home. Choose what fits the hour.</span>
              </span>
              <nav class="themectl" aria-label="Theme">
                <button data-mode="light" data-i18n="you.themeLight">Light</button>
                <button data-mode="dark" data-i18n="you.themeDark">Dark</button>
                <button data-mode="system" data-i18n="you.themeAuto">Auto</button>
              </nav>
            </div>
            <div class="yrow yrow-static">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.language">Language</span>
                <span class="yrow-d" data-i18n="you.languageD">Read Declare in English or Spanish.</span>
              </span>
              <nav class="langctl" id="langCtl" aria-label="Language">
                <button data-lang="en" data-i18n="you.langEn">English</button>
                <button data-lang="es" data-i18n="you.langEs">Español</button>
              </nav>
            </div>
            <button class="yrow" id="hubChurch">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.findChurch">Find a church</span>
                <span class="yrow-d" id="hubChurchD" data-i18n="you.findChurchD">Discover a fellowship near you</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </button>
            {/* Genuinely not built yet, so it is visibly disabled and labelled —
                never a row that looks live and does nothing. */}
            <button class="yrow" data-soon disabled aria-disabled="true">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.reminders">Reminders &amp; notifications</span>
                <span class="yrow-d" data-i18n="you.remindersD">A daily nudge back to the Word</span>
              </span>
              <span class="ysoon" data-i18n="you.soon">Coming soon</span>
            </button>
          </div>
        </section>

        {/* ── 6. Privacy & support ────────────────────────────────────── */}
        <section class="ysec" aria-labelledby="yHelpH">
          <h2 class="ysec-h serif" id="yHelpH" data-i18n="you.privacySupportH">Privacy &amp; support</h2>
          <div class="yrows m-rise">
            <a class="yrow" href="/help" data-i18n-href="/es/ayuda">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.help">Help &amp; support</span>
                <span class="yrow-d" data-i18n="you.helpD">Answers, contact, and help when you need it</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </a>
            <a class="yrow" href="/struggles" data-i18n-href="/es/luchas">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.strugglesCard">Struggles</span>
                <span class="yrow-d" data-i18n="you.strugglesCardD">Read what God says about what you carry</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </a>
            <a class="yrow" href="/privacy" data-i18n-href="/es/privacidad">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.privacy">Privacy</span>
                <span class="yrow-d" data-i18n="you.privacyD">How your words and data are handled</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </a>
            <a class="yrow" href="/terms" data-i18n-href="/es/terminos">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.terms">Terms</span>
                <span class="yrow-d" data-i18n="you.termsD">The agreement for using Declare</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </a>
            <button class="yrow" id="yRateCard">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.rate">Rate Declare</span>
                <span class="yrow-d" data-i18n="you.rateD">Tell us how it has met you</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </button>
            <button class="yrow" id="yWhatsNew">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.whatsNew">What’s new</span>
                <span class="yrow-d" data-i18n="you.whatsNewD">Updates, improvements, and fixes</span>
              </span>
              <span class="yrow-x" aria-hidden="true">›</span>
            </button>
          </div>
        </section>

        {/* ── 7. Mobile app ───────────────────────────────────────────── */}
        <section class="ysec" aria-labelledby="yAppH">
          <h2 class="ysec-h serif" id="yAppH" data-i18n="you.mobileAppH">Mobile app</h2>
          <div class="yrows m-rise">
            {/* No store link, no QR, no waitlist — none of those exist yet, and
                a button that goes nowhere is worse than an honest label. */}
            <div class="yrow yrow-static" id="yMobileApp">
              <span class="yrow-m">
                <span class="yrow-t" data-i18n="you.mobileAppT">Declare &amp; Believe mobile app</span>
                <span class="yrow-d" data-i18n="you.mobileAppD">The same Word, on your phone.</span>
              </span>
              <span class="ysoon" data-i18n="you.soon">Coming soon</span>
            </div>
          </div>
        </section>

        {/* ── 8. Sign out ─────────────────────────────────────────────── */}
        <section class="ysec ysec-end" aria-labelledby="ySessH">
          <h2 class="ysec-h sr-only" id="ySessH" data-i18n="you.sessionH">Session</h2>
          <button class="ysignout" id="ySignOut" hidden data-i18n="you.signOut">Sign out</button>
        </section>

          <div class="yver m-fade" id="yVer">DECLARE &middot; VERSION 3.19.1</div>
        </section>
      </div>
    </div>

    {/* ───── editor modal (Airbnb pattern: title · helper · field · Save) ───── */}
    <div class="ymodal" id="yModal">
      <div class="ym-back" id="ymBack"></div>
      <div class="ym-panel">
        <button class="ym-x" id="ymX" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
        <h3 class="serif" id="ymTitle"></h3>
        <p id="ymSub"></p>
        <div id="ymBody"></div>
        <div class="ym-actions"><button class="btn btn-primary" id="ymSave">Save</button></div>
      </div>
    </div>

    {/* ───── church finder overlay (Google Maps + Places, lazy) ───── */}
    <div class="yfinder" id="yFinder">
      <div class="yf-top">
        <button class="iconbtn" id="yfClose" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg></button>
        <div class="yf-h">
          <div class="ti serif" data-i18n="you.findChurch">Find a church</div>
          <div class="su" data-i18n="you.finderSub">Pick a suggestion — or press Enter to search anything</div>
        </div>
        <span class="iconbtn" style="visibility:hidden"></span>
      </div>
      <div class="yf-body">
        <div class="yf-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg><input id="yfInput" placeholder="City, state, or church name&hellip;" data-i18n-ph="you.finderPh" autocomplete="off" /></div>
        <button class="yf-loc" id="yfLoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path></svg><span data-i18n="you.useLocation">Use my location</span></button>
        <div class="yf-map" id="yfMap"></div>
        <div class="yf-list" id="yfList"></div>
        <div class="yf-missing" id="yfMissing" hidden>
          <div class="serif">Almost ready.</div>
          <p>The church finder needs its Google Maps key. Add <code>PUBLIC_GMAPS_KEY</code> to <code>.env</code> and restart the build &mdash; everything else on this page already works.</p>
        </div>
      </div>
    </div>

    <!-- church detail (house overlay: bottom sheet on mobile, centered card >=720) -->
    <div class="yfdetail" id="yfDetail">
      <div class="ym-back" id="yfdBack"></div>
      <div class="yfd-card">
        <button class="ym-x" id="yfdX" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        <div class="yfd-photo" id="yfdPhoto" hidden></div>
        <div class="yfd-body">
          <h3 class="serif" id="yfdName"></h3>
          <a class="yfd-addr" id="yfdAddr" target="_blank" rel="noopener"></a>
          <div class="yfd-meta" id="yfdMeta"></div>
          <div class="yfd-hours" id="yfdHours"></div>
          <div class="yfd-actions" id="yfdActions"></div>
          <button class="btn btn-primary yfd-set" id="yfdSet" data-i18n="you.setChurch">Set as my church</button>
        </div>
      </div>
    </div>

    <div class="ytoast" id="yToast"></div>

    {/* your-review view (read-only summary of what you rated) */}
    <div class="ymodal yrvmodal" id="yrvModal">
      <div class="ym-back" id="yrvBack"></div>
      <div class="ym-panel">
        <button class="ym-x" id="yrvX" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
        <h3 class="serif" data-i18n="you.yourReview">Your review</h3>
        <p class="yrv-status" id="yrvStatus"></p>
        <div class="yrv-dims" id="yrvDims"></div>
        <blockquote class="yrv-quote" id="yrvQuote" hidden></blockquote>
        <div class="ym-actions yrv-actions">
          <button class="btn btn-primary" id="yrvUpdate" type="button">Update my review</button>
          <a class="yrv-others" href="/welcome#testimonials">See what others are saying</a>
        </div>
      </div>
    </div>

    {/* what's new (release notes) — read-only log of updates, improvements, fixes */}
    <div class="ymodal yrlsmodal" id="yRlsModal">
      <div class="ym-back" id="yRlsBack"></div>
      <div class="ym-panel">
        <button class="ym-x" id="yRlsX" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
        <h3 class="serif" data-i18n="you.whatsNew">What&rsquo;s new</h3>
        <p class="yrls-sub" id="yRlsSub"></p>
        <div class="yrls-body" id="yRlsBody"></div>
      </div>
    </div>

    {/* Rate & Review surface (opened by the profile card or a ?rate= deep-link). */}
    <RateReview />
  </main>

  <script>
    import { getProfile, setProfile, daysWith } from '../app/declare/profile-store.js';
    import { listItems, listCollections, onChange } from '../app/declare/vault-store.js';
    import { onChange as onAccountSync } from '../app/declare/account-sync.js';
    import { initAuth, isConfigured, isSignedIn, currentUser, signOut, onAuthChange } from '../app/declare/auth-store.js';
    import { openAuthModal } from '../app/declare/auth-modal.js';
    import { initRateReview } from '../app/declare/rate-review.js';
    import { noteSubmitted } from '../app/declare/rate-gate.js';
    import { reviewsSubmit, reviewsMine, myEntitlements, openBillingPortal } from '../app/declare/convex-data.js';
    import {
      planState, showsPlusBadge, showsManageBilling, periodLabelKey,
      cadenceKey, formatPeriodEnd, planNameKey, STATE_LABEL_KEYS,
    } from '../app/declare/plan-display.js';

    const GMAPS_KEY = import.meta.env.PUBLIC_GMAPS_KEY || '';
    /* Every id passed to $() is rendered unconditionally by this page, so a
       miss means the markup changed and this script cannot do its job.
       Throwing fails at exactly the point the old code did — it raised
       "Cannot set properties of null" on the very next access — but names the
       id instead of leaving you to guess it.

       The lookups that are genuinely OPTIONAL (#yAvRemove, #yRateCard, #yVer,
       #yWhatsNew, #yRlsSub — present only in some states) call document.getElementById directly and keep their
       null checks. That distinction is the point: $() now means "must exist",
       and anything that might not exist says so at the call site. */
    const $ = (id: string): HTMLElement => {
      const el = document.getElementById(id);
      if (!el) throw new Error('you: missing #' + id);
      return el;
    };
    /* Same contract as $(), one level narrower: the page's own markup
       guarantees the tag, so a mismatch is a markup regression. */
    function $as<T extends HTMLElement>(id: string, ctor: { new (): T }, what: string): T {
      const el = $(id);
      if (!(el instanceof ctor)) throw new Error('you: #' + id + ' is not ' + what);
      return el;
    }

    /* e.target is typed EventTarget, which has no closest(). Both uses below are
       delegation on a container, so a non-Element target could never match the
       selector anyway. */
    function closestFrom<T extends HTMLElement>(e: Event, sel: string): T | null {
      const t = e.target;
      return t instanceof Element ? t.closest<T>(sel) : null;
    }

    /* ── This page's own shapes ──────────────────────────────────────────
       profile-store.js is untyped JavaScript; its header documents the shape
       and these are transcribed from it and from the reads below. Everything
       is optional because getProfile() returns `{}` for a new device. */
    interface Church { name: string; address?: string; placeId?: string; loc?: { lat: number; lng: number } }
    interface Profile {
      name?: string;
      about?: string;
      favoriteVerse?: string;
      interests?: string[];
      church?: Church | null;
      avatar?: string;
      since?: number;
    }
    /** The photo cropper's live geometry. Null whenever no crop is open. */
    interface CropState { iw: number; ih: number; FRAME: number; baseScale: number; zoom: number; tx: number; ty: number; url: string }
    /** What convex reviewsMine() returns for this account, or null. */
    interface MyReview {
      score_met_you: number;
      score_the_word: number;
      score_coming_back: number;
      status: string;
      isPublic?: boolean;
      testimonial?: string;
    }
    /** What the church finder reads off a Google Places result — and off the
     *  saved home church, which openDetail() accepts through the same door. */
    interface PlaceLike {
      name?: string;
      vicinity?: string;
      formatted_address?: string;
      formatted_phone_number?: string;
      website?: string;
      place_id?: string;
      rating?: number;
      user_ratings_total?: number;
      types?: string[];
      opening_hours?: { weekday_text?: string[]; isOpen?: () => boolean | undefined };
      photos?: Array<{ getUrl: (opts: { maxWidth: number; maxHeight: number }) => string }>;
      geometry?: { location?: google.maps.LatLng };
      /** Only on the SAVED home church, which doSetChurch() writes and
       *  openDetail() accepts through the same door as a Places result. */
      loc?: { lat: number; lng: number } | null;
    }

    const esc = (s?: string | null): string => (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    let P: Profile = getProfile();

    /* ---------- toast ---------- */
    let _tt: ReturnType<typeof setTimeout> | undefined;
    function toast(m: string): void { const t = $('yToast'); t.textContent = m; t.classList.add('show'); clearTimeout(_tt); _tt = setTimeout(() => t.classList.remove('show'), 2200); }

    // A signed-out device is a guest: show a clean slate (name, church, verse, about,
    // interests, photo, saved counts) no matter what is left in local storage. The data
    // is not destroyed — it returns when they sign back in. Personal info is account-tied.
    const signedInNow = () => isConfigured() && isSignedIn();

    /* ---------- rail: identity + real device stats ---------- */
    function renderRail(): void {
      const sIn = signedInNow();
      const name = sIn ? (P.name || '').trim() : '';
      $('yName').textContent = name || tY('you.friend','Friend');
      $('yAvText').textContent = name ? name[0].toUpperCase() : '✝';
      // uploaded photo (if any) overlays the initial; remove-link shows only with one
      (function () {
        const av = $('yAvatar'); let img = av.querySelector<HTMLImageElement>('.yav-img'); const rm = document.getElementById('yAvRemove');
        if (sIn && P.avatar) {
          if (!img) { img = document.createElement('img'); img.className = 'yav-img'; img.alt = ''; av.appendChild(img); }
          img.src = P.avatar; av.classList.add('has-photo'); if (rm) rm.hidden = false;
        } else {
          if (img) img.remove(); av.classList.remove('has-photo'); if (rm) rm.hidden = true;
        }
      })();
      const d = daysWith(P);
      $('yDays').textContent = String(d);
