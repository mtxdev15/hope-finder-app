---
// v3.2 /signin — a thin shell for the shared account modal (Julienne model:
// the card opens over the app; this route exists for deep links and the /you
// hub). The form, modes, validation and auth calls live in
// src/app/declare/auth-modal.js. ?return=<path> brings the user back.
import DeclareLayout from '../layouts/DeclareLayout.astro';
const MODE = 'signin';
---
<DeclareLayout title="Declare — Sign in" description="Sign in to Declare to keep what God gives you." noindex>
  <main class="authpage" data-mode={MODE}>
    <div class="topglow" aria-hidden="true"></div>

    <!-- accounts not configured yet (missing keys) -->
    <div class="ap-missing" id="apMissing" hidden>
      <div class="serif" data-i18n="signin.almost">Almost ready.</div>
      <p>Accounts need their Convex key. Add <code>PUBLIC_CONVEX_SITE_URL</code> to <code>.env.local</code> and restart the build &mdash; until then, everything works without signing in.</p>
      <a class="btn btn-ghost" href="/today" data-i18n="signin.back">Back to Declare</a>
    </div>
  </main>

  <script>
    import { initAuth, isConfigured, isSignedIn } from '../app/declare/auth-store.js';
    import { openAuthModal } from '../app/declare/auth-modal.js';

    // `return` is the canonical param. `next` is accepted as a legacy alias so a
    // link minted by older code (give.js used ?next=) still lands where it meant
    // to instead of silently defaulting to /you.
    //
    // Safety: resolve against our own origin and require the RESULT to be
    // same-origin, rather than pattern-matching the raw string. A prefix check
    // like startsWith('/') && !startsWith('//') looks right but is not: browsers
    // treat a backslash as a slash in the authority position, so "/\evil.com"
    // passes that check and still navigates to http://evil.com. Letting the URL
    // parser decide closes backslash, tab, and mixed-separator variants at once.
    // An auth page is the worst place to have an open redirect, since the bounce
    // lands right after someone has typed their password.
    const AUTH_ROUTES = ['/signin', '/create-account', '/reset-password'];
    function returnTo() {
      const q = new URLSearchParams(location.search);
      const raw = q.get('return') || q.get('next') || '';
      if (!raw) return '/you';
      let u;
      try { u = new URL(raw, location.origin); } catch (e) { return '/you'; }
      if (u.origin !== location.origin) return '/you';
      // Never bounce back into an auth shell: that is a redirect loop, not a destination.
      if (AUTH_ROUTES.includes(u.pathname)) return '/you';
      return u.pathname + u.search + u.hash;
    }

    /* querySelector returns Element | null, and `dataset` exists only on
       HTMLElement. Reading it straight through crashed the whole script if the
       shell markup ever changed; defaulting to 'signin' degrades instead. */
    const authPage = document.querySelector('.authpage');
    const mode = (authPage instanceof HTMLElement && authPage.dataset.mode === 'signup')
      ? 'signup'
      : 'signin';
    // Arriving from a confirm-email link: greet them, then send them into the app.
    const justVerified = new URLSearchParams(location.search).get('verified') === '1';
    const dest = justVerified ? '/today' : returnTo();
    initAuth().then(() => {
      if (!isConfigured()) {
        const missing = document.getElementById('apMissing');
        if (missing) missing.hidden = false;
        return;
      }
      if (isSignedIn()) { location.replace(dest); return; }
      openAuthModal({ mode, message: justVerified ? (window.I18N?.t('signin.verified', '') || 'Your email is confirmed. Sign in to continue.') : '', returnTo: dest, onSuccess: () => { location.href = dest; } });
      // closing the modal on this shell means "never mind" — go back
      const watch = setInterval(() => {
        const w = document.querySelector('.am-wrap');
        if (w && !w.classList.contains('open')) { clearInterval(watch); if (!isSignedIn()) location.href = dest; }
      }, 300);
    });
  </script>

  <style is:global>
    body:has(.authpage) > .tabbar, body:has(.authpage) > .mast { display: none; }
    .authpage { position: relative; min-height: 100dvh; }
    .authpage .ap-missing { position: relative; z-index: 1; min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 30px; }
    .authpage .ap-missing[hidden] { display: none; }
    .authpage .ap-missing .serif { font-size: 24px; color: var(--text); }
    .authpage .ap-missing p { font-size: 13px; color: var(--muted); line-height: 1.6; margin-top: 10px; max-width: 40ch; }
    .authpage .ap-missing code { color: var(--goldd); background: var(--field); padding: 2px 7px; border-radius: 6px; font-size: 12px; }
    .authpage .ap-missing .btn { margin-top: 22px; }
  </style>
</DeclareLayout>
