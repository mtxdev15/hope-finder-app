---
/* Stage 2 resume step 1 — the ONLY caller of billing.createCheckoutSession.
 *
 * WHY THIS PAGE EXISTS
 * Until now `convex/billing.ts` had zero callers anywhere in the repo, so
 * production was protected structurally: there was nothing to click. This page
 * gives the action a caller for the first time, which means the protection
 * stops being structural and becomes conditional. That is the whole reason for
 * the two gates below and for scripts/verify-billing-dev-control.ts.
 *
 * WHY A DYNAMIC ROUTE FOR A SINGLE PAGE
 * A plain src/pages/dev/billing-sandbox.astro would still be GENERATED in a
 * production build — an empty shell, but a real URL. A dynamic route whose
 * getStaticPaths returns [] generates nothing at all, so `dist/dev/` does not
 * exist. That turns "is the control absent from production?" into a binary,
 * greppable fact instead of an inspection of page contents.
 *
 * WHY `import.meta.env.DEV` IS THE LOAD-BEARING HALF
 * This tree contains .env.local, and Vite loads .env.local in EVERY mode,
 * production builds included. So the public flag alone is not a gate: a stray
 * PUBLIC_BILLING_DEV_CONTROL=1 in .env.local, in CI, or in a Cloudflare Pages
 * build setting would ship a live Checkout control. DEV is false in every
 * `astro build`, so a production build cannot contain this page even when the
 * flag is deliberately set to 1. Verified both ways by the test suite, which
 * runs against a build made with the flag ON.
 *
 * Same convention as the Journey pacing-lock bypass in src/pages/journey.astro.
 *
 * To enable locally:
 *   PUBLIC_BILLING_DEV_CONTROL=1 npm run dev
 *   http://localhost:4321/dev/billing-sandbox
 * or put the flag in .env.development.local, which Vite loads ONLY in dev mode.
 * Do NOT use .env.local, and do not add it to Cloudflare Pages build settings.
 */
import DeclareLayout from '../../layouts/DeclareLayout.astro';

/* GATE A — route existence, decided at build time.
 *
 * Two controls, two INDEPENDENT flags. The Test Clock harness
 * (`/dev/billing-harness`) is gated separately from the checkout control so
 * that enabling one never enables the other: they create very different
 * objects, and a single shared flag would make "I wanted the checkout page"
 * enough to expose a clock advance. */
export function getStaticPaths() {
  const enabled =
    import.meta.env.DEV && import.meta.env.PUBLIC_BILLING_DEV_CONTROL === '1';
  const harnessEnabled =
    import.meta.env.DEV && import.meta.env.PUBLIC_BILLING_HARNESS_CONTROL === '1';
  return [
    ...(enabled ? [{ params: { control: 'billing-sandbox' } }] : []),
    ...(harnessEnabled ? [{ params: { control: 'billing-harness' } }] : []),
  ];
}

const control = Astro.params.control;
const isHarness = control === 'billing-harness';
---
<DeclareLayout
  title="Declare — dev: sandbox billing"
  description="Development-only Stripe sandbox checkout control."
  activeTab=""
  noindex={true}
>
  {isHarness && (
  <main class="devbill">
    <div class="db-in">
      <div class="db-tag">Development only — sandbox tooling</div>
      <h1>Test Clock failure harness</h1>
      <p class="db-sub">
        Drives a throwaway sandbox subscription on a Stripe Test Clock through
        one failed renewal and back to healthy. The browser sends one
        allowlisted command string and nothing else — every Customer,
        Subscription, Test Clock, PaymentMethod, Invoice and Price identifier is
        resolved and held server side. Nothing here touches the existing monthly
        or annual subscriber.
      </p>

      <div id="hxAuth" class="db-strip">Checking session…</div>

      <section id="hxPanel" hidden>
        <dl class="db-fields" id="hxStatus" role="status" aria-live="polite"></dl>
        <div class="db-irow">
          <button id="hx_provision" type="button" class="db-btn" disabled>provision</button>
          <button id="hx_arm_failure" type="button" class="db-btn" disabled>arm_failure</button>
          <button id="hx_advance_to_renewal" type="button" class="db-btn" disabled>advance_to_renewal</button>
          <button id="hx_restore_and_pay" type="button" class="db-btn" disabled>restore_and_pay</button>
          <button id="hx_cancel_fixture" type="button" class="db-btn" disabled>cancel_fixture</button>
          <button id="hx_delete_clock" type="button" class="db-btn" disabled>delete_clock</button>
        </div>
        <div id="hxOut" class="db-out" hidden></div>
        <p class="db-note">
          Buttons are enabled only for the commands the current phase allows, and
          all six disable while a command is in flight. That is convenience, not
          the safety mechanism: Convex re-checks the phase, all four gates, and
          Test Clock ownership on every call, and refuses anything it does not
          expect. Error codes shown here are an allowlist — Stripe's own error
          text never reaches this page.
        </p>
      </section>
    </div>
  </main>
  )}

  {!isHarness && (
  <main class="devbill">
    <div class="db-in">
      <div class="db-tag">Development only</div>
      <h1>Plus monthly checkout</h1>
      <p class="db-sub">
        Stage 2 resume step 1. The browser sends one constant string,
        <code>plus-monthly</code>. The authenticated user, the Stripe Price and
        the Customer are all resolved server side inside Convex.
      </p>

      <div class="db-strip">
        Sandbox account <code>acct_1TmENuLShxhb4mBz</code>, test mode. Nothing on
        this page can charge a card.
      </div>

      <div id="dbAuth" class="db-auth">Checking your session&hellip;</div>

      <div id="dbControl" class="db-control" hidden>
        <!-- The disclaimer IS the label on each control, so no future layout
             edit can separate a purchase button from its warning. -->
        <button id="dbGo" type="button" class="db-btn">Stripe sandbox — no real charge</button>
        <div class="db-fine">
          Opens one $8.99/month Plus Checkout Session in Stripe test mode.
        </div>

        <button id="dbGoAnnual" type="button" class="db-btn db-btn-2">Stripe sandbox — no real charge</button>
        <div class="db-fine">
          Opens one $79.99/year Plus Checkout Session in Stripe test mode.
        </div>

        <!-- The one thing a tester must read before touching annual. -->
        <div class="db-warn" role="note">
          <strong>Do not buy annual on an account that already has an active
          subscription.</strong> The sandbox account holding the active monthly
          Plus subscription must not be used here. Use a separate sandbox QA
          account, or wait until that monthly subscription is genuinely
          terminal. Convex refuses a second purchase and the webhook guard
          refuses to repoint the row, but Stripe would still bill twice —
          neither guard cancels or refunds anything.
        </div>

        <button id="dbPortal" type="button" class="db-btn db-btn-3">Open the Stripe Billing Portal</button>
        <div class="db-fine">
          Creates a Portal session for your own account only. The Customer is
          resolved server-side from our stored mapping; the browser sends
          nothing.
        </div>
      </div>

      <div id="dbOut" class="db-out" hidden></div>

      <!-- ===== Read-only lifecycle inspector =====
           Reads the NORMAL entitlement response and nothing else. It writes
           nothing, mutates nothing, and shows no provider identifier. -->
      <section id="dbInspect" class="db-inspect" hidden aria-labelledby="dbInspectH">
        <h2 id="dbInspectH" class="db-ih">Entitlement state</h2>
        <div class="db-irow">
          <button id="dbRefresh" type="button" class="db-btn db-btn-ghost">Refresh</button>
          <label class="db-watch">
            <input type="checkbox" id="dbWatch" />
            <span>Watch for changes (bounded)</span>
          </label>
        </div>
        <dl class="db-fields" id="dbFields" role="status" aria-live="polite"></dl>
        <p class="db-note">
          Provider-neutral fields only, straight from <code>getMyEntitlements</code>.
          No Customer, Subscription, Price, invoice, event or Session id is read
          or shown. Note that cancel-at-period-end is <em>not</em> part of this
          contract, so a scheduled cancellation still reads as
          <code>active</code> here until Stripe moves the status.
        </p>
      </section>
    </div>
  </main>
  )}
</DeclareLayout>

<script>
  /* GATE B — code existence.
   *
   * The condition is written with the literals inline rather than through a
   * frontmatter variable, on purpose: Vite substitutes them at transform time,
   * so in any production build this folds to `if (false)` and esbuild drops the
   * entire body — including the dynamic imports, so no Convex or billing chunk
   * is emitted either. Must stay in sync with getStaticPaths above.
   *
   * Gate A alone would be enough today. Gate B is what survives someone later
   * converting this back to a static route. */
  if (import.meta.env.DEV && import.meta.env.PUBLIC_BILLING_DEV_CONTROL === '1') {
    (async () => {
      const $ = (id: string) => document.getElementById(id);
      const out = (html: string) => {
        const el = $('dbOut');
        if (!el) return;
        el.innerHTML = html;
        el.hidden = false;
      };
      const esc = (s: unknown) =>
        String(s).replace(/[&<>"]/g, (c) =>
          (({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }) as Record<string, string>)[c]);

      const auth = await import('../../app/declare/auth-store.js');
      const data = await import('../../app/declare/convex-data.js');
      const { projectEntitlement, INSPECTOR_FIELDS, refreshExhausted, REFRESH_INTERVAL_MS } =
        await import('../../app/declare/billing-inspector.js');

      /* Session state only. This makes no Stripe call and creates nothing. */
      await auth.initAuth().catch(() => {});
      const authEl = $('dbAuth');
      const ctrl = $('dbControl');

      if (!auth.isConfigured()) {
        if (authEl) authEl.textContent =
          'PUBLIC_CONVEX_SITE_URL is not set, so there is no session to authenticate.';
        return;
      }
      if (!auth.isSignedIn()) {
        if (authEl) authEl.innerHTML =
          'Not signed in. Checkout requires an authenticated user. ' +
          '<a href="/signin">Sign in</a>, then return here.';
        return;
      }

      const u: { email?: string; name?: string } = auth.currentUser() || {};
      if (authEl) authEl.textContent = 'Signed in as ' + (u.email || u.name || 'this account') + '.';
      if (ctrl) ctrl.hidden = false;

      /* Everything billing-shaped lives inside the click handlers: the Convex
       * client, the generated api, and the action calls. Nothing is imported
       * and no request is made until a button is pressed. */
      const btn = document.getElementById('dbGo') as HTMLButtonElement | null;
      const btnAnnual = document.getElementById('dbGoAnnual') as HTMLButtonElement | null;
      const btnPortal = document.getElementById('dbPortal') as HTMLButtonElement | null;
      if (!btn || !btnAnnual || !btnPortal) return;

      /* One authenticated Convex client, built on demand. Better Auth mints the
       * JWT, and that token is the ONLY identity that crosses the wire: there
       * is no userId, email, customer id or price id to send, and no argument
       * on either action that could carry one. */
      async function connect() {
        const { ConvexHttpClient } = await import('convex/browser');
        const { api } = await import('../../../convex/_generated/api');
        const convexUrl = import.meta.env.PUBLIC_CONVEX_URL || '';
        if (!convexUrl) { out('PUBLIC_CONVEX_URL is not set.'); return null; }
        const ac = auth.getAuthClient();
        const tok = ac && ac.convex
          ? await ac.convex.token({ fetchOptions: { throw: false } })
          : null;
        const token = (tok && tok.data && tok.data.token) || null;
        if (!token) {
          out('No Convex token. The session may have expired — sign in again.');
          return null;
        }
        const client = new ConvexHttpClient(convexUrl);
        client.setAuth(token);
        return { client, api };
      }

      /* Error codes are rendered verbatim: this is a diagnostic surface, not a
       * user-facing one. `already-subscribed` is the EXPECTED answer when the
       * account already holds a live subscription — that is Convex refusing a
       * second purchase, working as designed. */
      function fail(b: HTMLButtonElement, res: any) {
        out('<div class="db-err">' + esc((res && res.error) || 'no-response') +
            (res && res.status ? ' (' + esc(res.status) + ')' : '') + '</div>');
        b.disabled = false;
      }

      /* Deliberately NOT navigated. Creating a session and opening the hosted
       * page stay two separate, deliberate clicks. */
      function offer(kind: string, url: string, label: string) {
        out(
          '<div class="db-ok">' + esc(kind) + ' created.</div>' +
          '<div class="db-url">' + esc(url) + '</div>' +
          '<a class="db-open" href="' + esc(url) + '" target="_blank" rel="noopener noreferrer">' +
          esc(label) + '</a>'
        );
      }

      /* ONE Checkout implementation for both plans. The alias is a hardcoded
       * literal at each call site below — never read from the DOM, a dataset,
       * or the URL — so the browser cannot name anything but these two. The
       * Stripe Price for each is resolved server-side in Convex from
       * STRIPE_PLUS_MONTHLY_PRICE_ID / STRIPE_PLUS_ANNUAL_PRICE_ID. */
      async function startCheckout(b: HTMLButtonElement, plan: 'plus-monthly' | 'plus-annual') {
        b.disabled = true;
        out('Creating a Checkout Session&hellip;');
        try {
          const c = await connect();
          if (!c) { b.disabled = false; return; }
          const res = await c.client.action(c.api.billing.createCheckoutSession, { plan });
          if (res && res.url) offer('Checkout Session', res.url, 'Open Stripe Checkout in a new tab');
          else fail(b, res);
        } catch (e) {
          out('<div class="db-err">' + esc((e instanceof Error && e.message) || e) + '</div>');
          b.disabled = false;
        }
      }

      btn.addEventListener('click', () => startCheckout(btn, 'plus-monthly'));
      btnAnnual.addEventListener('click', () => startCheckout(btnAnnual, 'plus-annual'));

      /* Billing Portal. The action takes NO customer argument — Convex resolves
       * the Stripe Customer from our own billingCustomers mapping for the
       * authenticated user, and answers `no-subscription` when there is none.
       * The browser sends an empty payload. */
      btnPortal.addEventListener('click', async () => {
        btnPortal.disabled = true;
        out('Creating a Billing Portal session&hellip;');
        try {
          const c = await connect();
          if (!c) { btnPortal.disabled = false; return; }
          const res = await c.client.action(c.api.billing.createPortalSession, {});
          if (res && res.url) offer('Portal session', res.url, 'Open the Billing Portal in a new tab');
          else fail(btnPortal, res);
        } catch (e) {
          out('<div class="db-err">' + esc((e instanceof Error && e.message) || e) + '</div>');
          btnPortal.disabled = false;
        }
      });

      /* ── Read-only lifecycle inspector ─────────────────────────────────
       * Reads the NORMAL entitlement response and renders a PROJECTION of it.
       * The projection is an allowlist (billing-inspector.js), so a field it
       * does not name cannot reach the page even if the contract widens later.
       * Nothing here mutates anything. */
      const inspect = document.getElementById('dbInspect');
      if (inspect) inspect.hidden = false;
      const fieldsEl = document.getElementById('dbFields');
      let watchTicks = 0;
      let watchTimer: ReturnType<typeof setTimeout> | undefined;
      let reading = false;

      async function readState(): Promise<void> {
        if (reading) return;               // single-flight
        reading = true;
        let ent = null;
        try { ent = await data.myEntitlements(); } catch (e) { ent = null; }
        reading = false;
        if (!fieldsEl) return;
        /* The allowlist in billing-inspector.js is what decides which keys
           exist here; this only names the shape it returns. */
        const view: Record<string, unknown> | null = projectEntitlement(ent);
        if (!view) { fieldsEl.innerHTML = '<dt>state</dt><dd>unavailable</dd>'; return; }
        fieldsEl.innerHTML = INSPECTOR_FIELDS
          .filter((k: string) => Object.prototype.hasOwnProperty.call(view, k))
          .map((k: string) => '<dt>' + esc(k) + '</dt><dd>' + esc(JSON.stringify(view[k])) + '</dd>')
          .join('');
      }

      const refreshBtn = document.getElementById('dbRefresh');
      if (refreshBtn) refreshBtn.addEventListener('click', () => { readState(); });

      const watchBox = document.getElementById('dbWatch');
      function tickWatch(): void {
        if (refreshExhausted(watchTicks)) {
          if (watchBox instanceof HTMLInputElement) watchBox.checked = false;
          return;
        }
        watchTicks += 1;
        readState();
        watchTimer = setTimeout(tickWatch, REFRESH_INTERVAL_MS);
      }
      if (watchBox instanceof HTMLInputElement) {
        watchBox.addEventListener('change', () => {
          clearTimeout(watchTimer);
          watchTicks = 0;
          if (watchBox.checked) tickWatch();
        });
      }
      document.addEventListener('visibilitychange', () => { if (document.hidden) clearTimeout(watchTimer); });
      window.addEventListener('pagehide', () => clearTimeout(watchTimer));
      readState();
    })();
  }
</script>

<script>
  /* GATE B for the Test Clock harness — its OWN flag, inline literals so Vite
   * folds this to `if (false)` in any production build and esbuild drops the
   * body including the dynamic imports. Separate from the checkout gate below
   * on purpose: neither flag may enable the other. */
  if (import.meta.env.DEV && import.meta.env.PUBLIC_BILLING_HARNESS_CONTROL === '1') {
    (async () => {
      const g = (id: string) => document.getElementById(id);
      const esc2 = (s: unknown) =>
        String(s).replace(/[&<>"]/g, (c) =>
          (({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }) as Record<string, string>)[c]);
      const say = (html: string) => {
        const el = g('hxOut'); if (!el) return; el.innerHTML = html; el.hidden = false;
      };

      const auth = await import('../../app/declare/auth-store.js');
      await auth.initAuth().catch(() => {});
      const authEl = g('hxAuth');
      if (!auth.isConfigured()) {
        if (authEl) authEl.textContent = 'PUBLIC_CONVEX_SITE_URL is not set.';
        return;
      }
      if (!auth.isSignedIn()) {
        if (authEl) authEl.innerHTML =
          'Not signed in. The harness requires an authenticated disposable QA user. ' +
          '<a href="/signin">Sign in</a>, then return here.';
        return;
      }
      if (authEl) authEl.textContent = 'Signed in. Commands are enabled per phase.';
      const panel = g('hxPanel'); if (panel) panel.hidden = false;

      /* Everything Convex-shaped lives inside this closure and is imported on
         demand. Nothing billing-shaped loads on page view. */
      async function connect() {
        const { ConvexHttpClient } = await import('convex/browser');
        const { api } = await import('../../../convex/_generated/api');
        const url = import.meta.env.PUBLIC_CONVEX_URL || '';
        if (!url) { say('PUBLIC_CONVEX_URL is not set.'); return null; }
        const ac = auth.getAuthClient();
        const tok = ac && ac.convex ? await ac.convex.token({ fetchOptions: { throw: false } }) : null;
        const token = (tok && tok.data && tok.data.token) || null;
        if (!token) { say('No Convex token — sign in again.'); return null; }
        const client = new ConvexHttpClient(url);
        client.setAuth(token);
        return { client, api };
      }

      const COMMANDS = [
        'provision', 'arm_failure', 'advance_to_renewal',
        'restore_and_pay', 'cancel_fixture', 'delete_clock',
      ] as const;

      let pending = false;

      function render(status: any) {
        const dl = g('hxStatus');
        if (dl) {
          /* Only the safe projection is ever rendered. No provider identifier
             exists in this object to display, log, or write to the DOM. */
          dl.innerHTML = ['phase', 'inFlight', 'attemptCount', 'hasFixture', 'lastError']
            .map((k) => '<dt>' + esc2(k) + '</dt><dd>' + esc2(status ? status[k] : '—') + '</dd>')
            .join('');
        }
        const allowed: string[] = (status && status.allowed) || [];
        for (const c of COMMANDS) {
          const b = g('hx_' + c) as HTMLButtonElement | null;
          if (b) b.disabled = pending || !allowed.includes(c);
        }
      }

      async function refresh() {
        const c = await connect(); if (!c) return;
        try { render(await c.client.query(c.api.testHarness.fixtureStatus, {})); }
        catch { say('status-unavailable'); }
      }

      for (const command of COMMANDS) {
        const b = g('hx_' + command) as HTMLButtonElement | null;
        if (!b) continue;
        b.addEventListener('click', async () => {
          /* Client-side double-submit guard. The server enforces this too, via
             the in-flight phase — this only spares a pointless round trip. */
          if (pending) return;
          pending = true;
          render(null);
          const c = await connect();
          if (!c) { pending = false; return; }
          try {
            /* The ENTIRE payload: one allowlisted command string. */
            const res = await c.client.action(c.api.testHarness.runCommand, { command });
            say(res && res.ok
              ? '<div>ok — ' + esc2(command) + '</div>'
              : '<div class="db-err">' + esc2((res && res.error) || 'no-response') + '</div>');
          } catch {
            say('<div class="db-err">request-failed</div>');
          }
          pending = false;
          await refresh();
        });
      }

      await refresh();
    })();
  }
</script>

<style>
  .devbill { position: relative; min-height: 100dvh; padding: 24px 0 96px; }
  .db-in { width: min(560px, calc(100% - 32px)); margin: 0 auto; }
  .db-tag {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: #13211A; background: var(--gold);
    padding: 4px 10px; border-radius: 100px;
  }
  .devbill h1 {
    font-family: 'Cormorant Garamond', serif; font-size: 30px; line-height: 1.15;
    color: var(--text); font-weight: 500; margin: 14px 0 0;
  }
  .db-sub { font-size: 14px; line-height: 1.65; color: var(--muted); margin: 10px 0 0; }
  .db-sub code, .db-strip code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; }
  .db-strip {
    margin-top: 18px; padding: 12px 14px; border: 1px solid var(--gold);
    border-radius: 12px; font-size: 12.5px; line-height: 1.55; color: var(--text2);
  }
  .db-auth { margin-top: 18px; font-size: 13.5px; line-height: 1.6; color: var(--text2); }
  .db-auth a { color: var(--goldd); font-weight: 600; }
  .db-control { margin-top: 18px; }
  .db-btn {
    width: 100%; padding: 15px 18px; border-radius: 14px; border: 1px solid var(--gold);
    background: var(--gold); color: #13211A; font-size: 15px; font-weight: 700;
    cursor: pointer; line-height: 1.3;
  }
  .db-btn[disabled] { opacity: .55; cursor: not-allowed; }
  .db-fine { font-size: 11.5px; line-height: 1.5; color: var(--muted); text-align: center; margin-top: 9px; }
  .db-out {
    margin-top: 18px; padding: 14px; border: 1px solid var(--line); border-radius: 12px;
    background: var(--surface); font-size: 13px; line-height: 1.6; color: var(--text2);
  }
  .db-ok { font-weight: 600; color: var(--text); }
  .db-err { font-weight: 600; color: #E4736B; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .db-url {
    margin-top: 8px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px; word-break: break-all; color: var(--muted);
  }
  .db-open { display: inline-block; margin-top: 12px; font-size: 13.5px; font-weight: 600; color: var(--goldd); }
  .db-btn-2, .db-btn-3 { margin-top: 18px; }
  .db-btn-3 { background: transparent; color: var(--text); border-color: var(--line2); }
  .db-btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--line2); width: auto; min-height: 44px; padding: 10px 18px; font-size: 14px; }
  .db-warn { margin-top: 16px; padding: 12px 14px; border: 1px solid #E4736B; border-radius: 12px; font-size: 12.5px; line-height: 1.6; color: var(--text2); text-align: left; }
  .db-warn strong { color: #E4736B; }
  .db-inspect { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--line); }
  .db-ih { font-family: 'Cormorant Garamond', serif; font-size: 21px; font-weight: 500; color: var(--text); margin: 0; }
  .db-irow { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 12px; }
  .db-watch { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 13px; color: var(--muted); cursor: pointer; }
