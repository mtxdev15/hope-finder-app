---
// Thin wrapper. All content, copy and plan data come from the shared component.
import DeclareLayout from '../layouts/DeclareLayout.astro';
import PricingBody from '../components/PricingBody.astro';
import { COPY, ROUTES } from '../data/plans';
const t = COPY.en;
const alternates = [
  { hreflang: 'en', path: ROUTES.pricing.en },
  { hreflang: 'es', path: ROUTES.pricing.es },
  { hreflang: 'x-default', path: ROUTES.pricing.en },
];
---
<DeclareLayout title={t.pricingTitle} description={t.pricingDescription} lang="en" alternates={alternates}>
  <Fragment slot="head">
    <script is:inline>
      /* Compatibility only: /pricing?lang=es was the old Spanish URL, the
         permanent one is /es/precios. This must run BEFORE the i18n engine,
         which consumes ?lang= and strips it from the URL — after that the hop
         is impossible. Cloudflare Pages cannot match query strings, so this is
         the only place it can live. Deliberately NOT a browser-language
         redirect: only an explicit stale ?lang=es. */
      try {
        if (new URLSearchParams(location.search).get('lang') === 'es') {
          location.replace('/es/precios');
        }
      } catch (e) {}
      /* Language-pinned by URL, symmetric with /es/precios: without this an
         English URL visited with a Spanish cookie renders English copy under
         lang="es" with Spanish chrome, which contradicts the hreflang promise
         that this URL is the English one. */
      try { document.cookie = 'declare-lang=en;path=/;max-age=31536000;samesite=lax'; } catch (e) {}
      try { localStorage.setItem('declare-lang', 'en'); } catch (e) {}
    </script>
  </Fragment>
  <PricingBody lang="en" />
</DeclareLayout>
