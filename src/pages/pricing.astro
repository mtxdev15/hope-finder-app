---
/* /pricing — PLANS. One job: "which plan is right for me?"
 *
 * WHAT THIS PAGE IS NOT
 * It is not a billing dashboard. There is no invoice list, no payment method,
 * no cancellation control and no Portal session here. Managing an existing
 * subscription lives at /billing, and the two pages are deliberately kept
 * apart: comparing plans and managing the one you hold are different jobs, and
 * a page that tries to do both does neither clearly.
 *
 * NON-TRANSACTIONAL BY CONSTRUCTION: no Checkout call, no Stripe reference and
 * no enabled purchase control anywhere on this page. It performs exactly one
 * authenticated read — getMyEntitlements — so a signed-in reader can see which
 * plan they already hold. That is a Convex query, not a Stripe call.
 *
 * ONE CURRENT PLAN, DERIVED ONCE
 * Each card used to decide for itself whether it was current, with two
 * different labels for the one idea and nothing forbidding both from winning.
 * Current plan is now resolved a single time by currentPlanId() in
 * plan-display.js, from the same display state /billing uses, and the cards
 * only ask. Whether Plus can be BOUGHT is a separate question from whether it
 * is already HELD — conflating them is how a paying subscriber was told Plus
 * was "opening soon".
 *
 * FAILS CLOSED: while entitlement state is loading, unknown or ambiguous, no
 * card is marked current and nothing becomes purchasable.
 *
 * Spanish uses the runtime convention (data-i18n + i18n-strings.js with the
 * declare-lang cookie), reached as /pricing?lang=es.
 */
import DeclareLayout from '../layouts/DeclareLayout.astro';
import LegalFooter from '../components/LegalFooter.astro';
---
<DeclareLayout
  title="Declare — Plans"
  description="Compare Free and Plus. Scripture and the core Declare experience stay free on every plan."
  activeTab=""
>
  <main class="plans">
    <div class="topglow" aria-hidden="true"></div>
    <div class="in">
      <div class="sub-top">
        <a class="iconbtn" href="/today" aria-label="Back" data-i18n-aria="pricing.back"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"></path></svg></a>
        <span class="ttl" data-i18n="plans.eyebrow">Plans</span>
        <span class="iconbtn" style="visibility:hidden"></span>
      </div>

      <header class="pl-hero rise d1">
        <h1 data-i18n="plans.h1">Choose the support that fits your journey.</h1>
        <p class="pl-sub" data-i18n="plans.sub">Start free and stay free. When three answers a day stops being enough, Plus takes the ceiling off.</p>
      </header>

      {/* Cadence. A radiogroup rather than two buttons, so the selected state is
          announced rather than merely coloured, and arrow keys work the way a
          segmented control should. Changing it changes what is PRICED — never
          which plan is current. */}
      <div class="pl-cadence rise d2">
        <div class="seg" role="radiogroup" aria-labelledby="plCadenceLbl" id="plCadence">
          <span class="sr-only" id="plCadenceLbl" data-i18n="plans.cadenceLabel">How Plus is billed</span>
          {/* Follows the selected option. Positioned from script rather than by
              a percentage, because the two options are not the same width: the
              annual one carries the saving. */}
          <span class="seg-thumb" id="segThumb" aria-hidden="true"></span>
          <button type="button" class="seg-o" id="segMonth" role="radio" aria-checked="true" data-interval="month">
            <span data-i18n="plans.monthly">Monthly</span>
          </button>
          <button type="button" class="seg-o" id="segYear" role="radio" aria-checked="false" data-interval="year">
            <span data-i18n="plans.annual">Annual</span>
            <span class="seg-save" id="segSave" data-i18n="plans.save26">Save 26%</span>
          </button>
        </div>
      </div>

      <div class="pl-grid">
        {/* ── Free ─────────────────────────────────────────────────────── */}
        <article class="pl-card rise d3" id="plFree" aria-labelledby="plFreeNm">
          <div class="pl-badge" id="plFreeBadge" hidden></div>
          <h2 class="pl-nm" id="plFreeNm" data-i18n="plans.freeName">Free</h2>
          <p class="pl-desc" data-i18n="plans.freeDesc">Essential tools to begin and keep growing.</p>
          <div class="pl-price"><span class="pl-amt">$0</span></div>
          <div class="pl-per" data-i18n="plans.forever">Always</div>
          <ul class="pl-list">
            <li data-i18n="plans.freeF1">The full Bible and the whole Declare experience</li>
            <li data-i18n="plans.freeF2">3 Gentle Guidance responses a day</li>
            <li data-i18n="plans.freeF3">3 Journeys open at a time, 5 days each</li>
            <li data-i18n="plans.freeF4">Your declarations, reflections and Vault, kept</li>
          </ul>
          <div class="pl-cta" id="plFreeCta">
            <a class="btn btn-ghost" href="/create-account" data-i18n="plans.freeCreate">Create a free account</a>
          </div>
        </article>

        {/* ── Plus ─────────────────────────────────────────────────────── */}
        <article class="pl-card pl-plus rise d4" id="plPlus" aria-labelledby="plPlusNm">
          <div class="pl-badge" id="plPlusBadge" hidden></div>
          <h2 class="pl-nm" id="plPlusNm" data-i18n="plans.plusName">Plus</h2>
          <p class="pl-desc" data-i18n="plans.plusDesc">For the night when three answers are not enough.</p>
          <div class="pl-price">
            <span class="pl-amt" id="plPlusAmt">$8.99</span>
            <span class="pl-cur" id="plPlusPer" data-i18n="plans.perMonth">/ month</span>
          </div>
          <div class="pl-per" id="plPlusNote" data-i18n="plans.billedMonthly">Billed monthly</div>
          <ul class="pl-list">
            <li data-i18n="plans.plusF1">Everything in Free</li>
            <li data-i18n="plans.plusF2">Gentle Guidance with no daily limit</li>
            <li data-i18n="plans.plusF3">As many Journeys as you need, at the same time</li>
            <li data-i18n="plans.plusF4">Keep going at 3am without counting what is left</li>
          </ul>
          <div class="pl-cta" id="plPlusCta">
            {/* Served disabled. Only an explicit activation may change that, and
                it lives in one place — PRICING_ENABLED in plan-display.js. */}
            <button type="button" class="btn btn-primary" id="plPlusBtn" disabled data-i18n="plans.launchSoon">Plus launches soon</button>
          </div>
          <p class="pl-life" id="plPlusLife" role="status" hidden></p>

          {/* ── HOW YOUR FREE TRIAL WORKS ────────────────────────────────
              The screen three unrelated apps put in front of a trial: stoic.,
              Pillow and Ahead all show this exact timeline, which is a strong
              signal it is doing real work rather than decorating.

              WHAT IT IS FOR. A card-up-front trial converts several times
              better than one where the reader has to come back and choose to
              pay, and it is also the version people resent, for one reason: a
              charge nobody saw coming. This removes the surprise BEFORE they
              commit by naming the day we will email them and the day the money
              moves. The promise made here is kept by convex/dunning.ts.

              Revealed by the CTA rather than shown always, so the plans stay
              comparable at a glance. Inert until purchasing opens: the button
              above ships disabled and this panel is never reached. */}
          <div class="pl-trial" id="plTrial" hidden>
            <h3 class="pl-trial-h" data-i18n="plans.trialH">How your free trial works</h3>
            <ol class="pl-trial-steps">
              <li>
                <strong data-i18n="plans.trialS1">Today: everything unlocks</strong>
                <span data-i18n="plans.trialS1d">Unlimited Gentle Guidance, unlimited Journeys, all of it. Nothing is held back.</span>
              </li>
              <li>
                <strong data-i18n="plans.trialS2">Day 4: we email you</strong>
                <span data-i18n="plans.trialS2d">A reminder that your trial is ending, with the date and the amount. Cancelling takes under a minute.</span>
              </li>
              <li>
                <strong data-i18n="plans.trialS3">Day 7: your plan begins</strong>
                {/* The date is filled in by script. It is OUR arithmetic until
                    Stripe creates the subscription, so it is phrased alongside
                    "in 7 days" rather than presented as a certainty. */}
                <span id="plTrialCharge"></span>
              </li>
            </ol>
            <p class="pl-trial-sub" id="plTrialSub"></p>
            <p class="pl-trial-err" id="plTrialErr" role="alert" hidden></p>
            <div class="pl-cta">
              <button type="button" class="btn btn-primary" id="plTrialGo" data-i18n="plans.startTrial">Start my 7 days free</button>
            </div>
          </div>
        </article>

        {/* ── Lifetime ─────────────────────────────────────────────────────
            NOT a third point on the monthly-or-annual axis, and the design says
            so: it is the one card the cadence control above does not price. A
            one-time purchase sitting in an identical column invites the reader
            to divide it by twelve and compare, which is the wrong comparison.

            NO TRIAL, and the card says so rather than leaving it to be noticed
            at checkout. Stripe runs this in `mode: "payment"`, and a trial is a
            delay before a first charge on a subscription that does not exist
            here. The note is the honest version of an absence.

            THE SEAT NUMBER IS SERVER-SIDE. It is written in by script from
            convex/plusPlans.ts, never typed here, so the page cannot promise a
            round size that differs from the cap that gates the purchase. */}
        {/* `pl-once`, not `pl-life`: .pl-life is already the Plus card's
            lifecycle sentence a few lines above, and a card sharing that class
            inherits its type and margin. */}
        <article class="pl-card pl-once rise d5" id="plLife" aria-labelledby="plLifeNm">
          <div class="pl-badge" id="plLifeBadge" hidden></div>
          <h2 class="pl-nm" id="plLifeNm" data-i18n="plans.lifeName">Lifetime</h2>
          <p class="pl-desc" data-i18n="plans.lifeDesc">Pay once. Plus stays yours for as long as Declare is here.</p>
          <div class="pl-price">
            <span class="pl-amt" id="plLifeAmt">$149</span>
            <span class="pl-cur" data-i18n="plans.lifeOnce">once</span>
          </div>
          <div class="pl-per" data-i18n="plans.lifeNote">Less than two years of annual</div>
          <ul class="pl-list">
            <li data-i18n="plans.lifeF1">Everything in Plus, kept for good</li>
            <li data-i18n="plans.lifeF2">No renewal and no card left on file</li>
            <li data-i18n="plans.lifeF3">Every future Plus feature included</li>
            {/* Filled in from the server cap. Ships with no number at all rather
                than with a guess, so a failed read shows one fewer bullet
                instead of a seat count we invented. */}
            <li id="plLifeSeats" hidden></li>
          </ul>
          {/* ABOVE the button, not below it. Three cards whose buttons sit on
              three different baselines is the first thing the eye catches, and
              anything after the CTA on one card lifts that card's CTA by its own
              height. It also belongs here on the reading order: this is the last
              thing somebody should know BEFORE they press, not after. */}
          <p class="pl-fine" data-i18n="plans.lifeNoTrial">A one-time purchase, so the 7 free days apply to monthly and annual.</p>
          <p class="pl-trial-err" id="plLifeErr" role="alert" hidden></p>
          <div class="pl-cta" id="plLifeCta">
            <button type="button" class="btn btn-primary" id="plLifeBtn" disabled data-i18n="plans.launchSoon">Plus launches soon</button>
          </div>
        </article>
      </div>

      {/* ── Comparison ─────────────────────────────────────────────────── */}
      <section class="pl-cmp rise d4" aria-labelledby="plCmpH">
        <h2 class="pl-cmp-h" id="plCmpH" data-i18n="plans.compareH">What changes with Plus</h2>
        <table class="pl-table">
          <caption class="sr-only" data-i18n="plans.compareCap">Free and Plus compared, feature by feature</caption>
          <thead>
            <tr>
              <th scope="col" data-i18n="plans.feature">Feature</th>
              <th scope="col" data-i18n="plans.freeName">Free</th>
              <th scope="col" data-i18n="plans.plusName">Plus</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" data-i18n="plans.rScripture">Scripture and core support</th>
              <td data-lbl="Free" data-i18n="plans.included">Included</td>
              <td data-lbl="Plus" data-i18n="plans.included">Included</td>
            </tr>
            <tr>
              <th scope="row" data-i18n="plans.rGuidance">Gentle Guidance</th>
              <td data-lbl="Free" data-i18n="plans.rGuidanceFree">3 a day</td>
              <td data-lbl="Plus" data-i18n="plans.unlimited">Unlimited</td>
            </tr>
            <tr>
              <th scope="row" data-i18n="plans.rActive">Journeys open at a time</th>
              <td data-lbl="Free" data-i18n="plans.rActiveFree">3</td>
              <td data-lbl="Plus" data-i18n="plans.unlimited">Unlimited</td>
            </tr>
            <tr>
              <th scope="row" data-i18n="plans.rNew">Starting new Journeys</th>
              <td data-lbl="Free" data-i18n="plans.unlimited">Unlimited</td>
              <td data-lbl="Plus" data-i18n="plans.unlimited">Unlimited</td>
            </tr>
            <tr>
              <th scope="row" data-i18n="plans.rVault">Vault, reflections and declarations</th>
              <td data-lbl="Free" data-i18n="plans.unlimited">Unlimited</td>
              <td data-lbl="Plus" data-i18n="plans.unlimited">Unlimited</td>
            </tr>
          </tbody>
        </table>
        {/* Said once, here, rather than given a third column that would repeat
            the Plus column exactly. Lifetime differs in how it is bought, never
            in what it grants. */}
        <p class="pl-cmp-note" data-i18n="plans.compareLife">Lifetime grants this same Plus. It is bought once instead of monthly.</p>
      </section>

      {/* ── Reassurance ────────────────────────────────────────────────── */}
      <ul class="pl-trust rise d4">
        <li data-i18n="plans.trust1">Secure billing through Stripe.</li>
        <li data-i18n="plans.trust2">Cancel anytime.</li>
        <li data-i18n="plans.trust3">Your plan changes app limits, never your access to Scripture.</li>
      </ul>

      {/* ── Crisis help ─────────────────────────────────────────────────
          NOT A PLAN FEATURE, and deliberately not in the comparison table or
          the Free card any more. It used to appear in both, which framed help
          for somebody in danger as something a subscription tier governs.

          It is a signpost to other people's services. Declare does not provide
          it, does not gate it, and has no business counting it as a benefit.
          Kept here, below the plans and above the questions, because somebody
          who scrolled this far while struggling should not have to hunt. */}
      <aside class="pl-help rise d4" aria-labelledby="plHelpH">
        <h2 class="pl-help-h" id="plHelpH" data-i18n="plans.helpH">If you are in crisis right now</h2>
        <p class="pl-help-d" data-i18n="plans.helpD">
          Please reach out to a crisis line. They are staffed by people trained for this,
          they are free, and they have nothing to do with Declare or with any plan.
        </p>
        <a class="pl-help-a" href="/crisis" data-i18n="plans.helpCta">Find help now</a>
      </aside>

      {/* ── FAQ ────────────────────────────────────────────────────────── */}
      <section class="pl-faq rise d4" aria-labelledby="plFaqH">
        <h2 class="pl-cmp-h" id="plFaqH" data-i18n="plans.faqH">Questions people ask</h2>
        <details class="pl-q">
          <summary data-i18n="plans.q0">How does the free trial work?</summary>
          <p data-i18n="plans.a0">You get 7 days of everything Plus has, unlocked from the moment you start. We email you on day 4 to say the trial is ending, with the date and the amount, so nothing arrives as a surprise. If you cancel before day 7 you are not charged. One trial per account.</p>
        </details>
        <details class="pl-q">
          <summary data-i18n="plans.q1">Does paying change what God gives me?</summary>
          <p data-i18n="plans.a1">No. Plus changes what the app allows, not what God gives. Scripture, your Journey and your Vault are the same on every plan.</p>
        </details>
        <details class="pl-q">
          <summary data-i18n="plans.q2">What happens if I cancel?</summary>
          <p data-i18n="plans.a2">Your Plus access stays available until the end of the period you have already paid for. After that your account returns to Free, and everything you have saved stays yours.</p>
        </details>
        <details class="pl-q">
          <summary data-i18n="plans.q3">What if a payment fails?</summary>
          <p data-i18n="plans.a3">Nothing shuts off that day. Your Plus stays on for 16 days while we keep trying the card, and we email you along the way so nothing is a surprise. Most of the time it is simply an expired or replaced card, and updating it in Billing takes about a minute. If money is the reason, reply to any of those emails and tell us. We will work something out.</p>
        </details>
        <details class="pl-q">
          <summary data-i18n="plans.q4">Can I switch between monthly and annual?</summary>
          <p data-i18n="plans.a4">Yes. You can switch to annual any time from Billing. We credit the days you have already paid for and not used, so you only pay the difference, and your next renewal is the annual price.</p>
        </details>
      </section>

    </div>
  <LegalFooter />
  </main>

<script>
  /* Reflect the signed-in reader's CURRENT plan, and run the cadence selector.
   *
   * This page imports no billing action and can create no Checkout or Portal
   * session. A subscriber is routed to /billing, which owns that.
   *
   * FAILS CLOSED: while entitlement state is loading, unknown or ambiguous,
   * neither card is marked current and nothing becomes purchasable. */
  import { myEntitlements, lifetimeAvailability } from '../app/declare/convex-data.js';
  import {
    planState, mayStartCheckout, currentPlanId, isCurrentPlan, planStatusKey,
    plusCtaIntent, freeCtaIntent, initialInterval, formatPeriodEnd,
    PRICING_ENABLED, PLUS_MONTHLY_CENTS, PLUS_ANNUAL_CENTS, PLUS_LIFETIME_CENTS,
    TRIAL_DAYS, isLifetime,
  } from '../app/declare/plan-display.js';
  import { track } from '../app/declare/analytics.js';

  const el = (id: string) => document.getElementById(id);

  /* English lives in the DOM for static markup, but text created at runtime has
     no element to read it from — so for those strings the FALLBACK is the
     English copy. One shared fallback is therefore a bug, not a shortcut: it
     made every dynamic badge read "Current plan", including the one that was
     supposed to say "Needs attention". Every key gets its own word. */
  const EN: Record<string, string> = {
    'plans.currentPlan': 'Current plan',
    'plan.stateAttention': 'Needs attention',
    'plan.stateEnding': 'Ending',
    'plan.stateAmbiguous': 'Needs a look',
    'plan.manage': 'Manage billing',
    'plan.updatePayment': 'Update payment',
    'plan.keepPlus': 'Keep Plus',
    'plan.monthly': 'Monthly plan',
    'plan.annual': 'Annual plan',
    'plan.renews': 'Renews',
    'plan.cancels': 'Cancels',
    'plan.plusName': 'Declare Plus',
    'plan.freeName': 'Free plan',
    'plan.loadingName': 'Loading your plan',
    'plan.cancellingMsg': 'Your Plus access remains available until the end of the period.',
    'plan.attentionMsg': 'Something about your payment needs a second look. You still have access while we sort it out.',
    'plan.ambiguousMsg': 'This account looks like it is being billed in more than one place.',
    'plans.freeCreate': 'Create a free account',
    'plans.launchSoon': 'Plus launches soon',
    'plans.startTrial': 'Start my 7 days free',
    'plans.trialH': 'How your free trial works',
    'plans.trialS1': 'Today: everything unlocks',
    'plans.trialS1d': 'Unlimited Gentle Guidance, unlimited Journeys, all of it. Nothing is held back.',
    'plans.trialS2': 'Day 4: we email you',
    'plans.trialS2d': 'A reminder that your trial is ending, with the date and the amount. Cancelling takes under a minute.',
    'plans.trialS3': 'Day 7: your plan begins',
    'plans.trialCharge': 'Your card is charged {price} in 7 days, on {date}.',
    'plans.opening': 'Opening secure checkout…',
    'plans.errUnavailable': 'We could not open checkout just now. Please try again.',
    'plans.errAlready': 'You already have Plus on this account. Open Billing to manage it.',
    'plans.errSoldOut': 'The founding-member round is full.',
    'plans.trialSub': '7 days free, then {price}. Cancel anytime.',
    'plans.upgrade': 'Upgrade to Plus',
    'plans.perMonth': '/ month',
    'plans.perYear': '/ year',
    'plans.billedMonthly': 'Billed monthly',
    'plans.billedAnnual': 'Billed annually, about $6.67 a month',
    'plans.lifeCta': 'Become a founding member',
    'plans.lifeSoldOut': 'The founding round is full',
    'plans.lifeSeats': '{seats} founding seats in this round',
    'plans.errSeatsGone': 'The last founding seat went while you were reading. Monthly and annual are still open.',
  };

  /* The fallback is looked up per key. A caller may still pass one explicitly,
     but it can never silently stand in for a different string. */
  const tx = (k: string, fallback?: string): string => {
    const en = EN[k] !== undefined ? EN[k] : (fallback !== undefined ? fallback : k);
    return window.I18N ? window.I18N.t(k, en) : en;
  };

  /* Prices live here as content, in cents, so the comparison and the saving are
     computed from one pair of numbers rather than three hardcoded strings. */
  /* Imported, not restated — /billing renders these too, and one price with
     two definitions is one price too many. */
  const MONTHLY_CENTS = PLUS_MONTHLY_CENTS;
  const ANNUAL_CENTS = PLUS_ANNUAL_CENTS;
  const money = (cents: number) => '$' + (cents / 100).toFixed(2);
  /* Whole dollars printed without the cents. $8.99 keeps them because they are
     real; $149.00 spends two characters saying nothing, and on a one-time price
     sitting beside two recurring ones the shorter figure is the clearer one. */
  const moneyRound = (cents: number) =>
    cents % 100 === 0 ? '$' + String(cents / 100) : money(cents);


  let interval: 'month' | 'year' = 'month';
  let planStateNow = 'loading';

  function paintCadence(): void {
    for (const id of ['segMonth', 'segYear']) {
      const b = el(id);
      if (!b) continue;
      const on = b.getAttribute('data-interval') === interval;
      b.setAttribute('aria-checked', on ? 'true' : 'false');
      b.classList.toggle('is-on', on);
      /* Roving tabindex: the group is one stop, arrows move within it. */
      b.setAttribute('tabindex', on ? '0' : '-1');
    }
    moveThumb();

    const amt = el('plPlusAmt');
    const per = el('plPlusPer');
    const note = el('plPlusNote');
    const nextAmt = money(interval === 'year' ? ANNUAL_CENTS : MONTHLY_CENTS);
    /* Only when the figure actually changes. Replaying the animation on every
       repaint would make the price twitch while somebody reads it. */
    if (amt && amt.textContent !== nextAmt) swap(amt);
    if (amt) amt.textContent = nextAmt;
    if (interval === 'year') {
      if (per) per.textContent = tx('plans.perYear', '/ year');
      if (note) note.textContent = tx('plans.billedAnnual', 'Billed annually, about $6.67 a month');
    } else {
      if (per) per.textContent = tx('plans.perMonth', '/ month');
      if (note) note.textContent = tx('plans.billedMonthly', 'Billed monthly');
    }
  }

  /* Slide the selected pill under whichever option is on. Measured rather than
     computed as a percentage, because Annual is wider than Monthly: it carries
     the saving inside it. Falls back to nothing if the elements are missing,
     which leaves the plain .is-on background doing the work. */
  function moveThumb(): void {
    const thumb = el('segThumb');
    const on = el(interval === 'year' ? 'segYear' : 'segMonth');
    /* `rail`, not `track`: this module already imports a track() for analytics,
       and a local of that name inside this function would shadow it. */
    const rail = el('plCadence');
    if (!thumb || !on || !rail) return;
    const a = on.getBoundingClientRect();
    const b = rail.getBoundingClientRect();
    if (!a.width) return;
    thumb.style.width = a.width + 'px';
    thumb.style.transform = 'translateX(' + (a.left - b.left - 4) + 'px)';
    thumb.style.opacity = '1';
    /* Only now does the selected option stop painting its own background. Set
       here rather than in markup so a measurement that never succeeds leaves
       the no-script appearance intact. */
    rail.classList.add('has-thumb');
  }

  /* One short lift-and-settle on a figure that just changed. Restarted by
     removing and re-adding the class inside a reflow read, because re-adding
     alone does not replay a running animation. */
  function swap(node: HTMLElement): void {
    node.classList.remove('is-swap');
    void node.offsetWidth;
    node.classList.add('is-swap');
  }

  function setInterval2(next: 'month' | 'year', announce: boolean): void {
    if (next === interval) return;
    interval = next;
    paintCadence();
    if (announce) {
      track('billing_interval_selected', {
        authenticated: planStateNow !== 'guest' && planStateNow !== 'loading',
        displayed_tier: currentPlanId(planStateNow) || 'none',
        selected_interval: interval,
        pricing_enabled: PRICING_ENABLED,
      });
    }
  }

  for (const id of ['segMonth', 'segYear']) {
    const b = el(id);
    if (!b) continue;
    b.addEventListener('click', () => {
      const v = b.getAttribute('data-interval');
      if (v === 'month' || v === 'year') setInterval2(v, true);
    });
    b.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight' && e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
      e.preventDefault();
      const next = interval === 'month' ? 'year' : 'month';
      setInterval2(next, true);
      const target = el(next === 'month' ? 'segMonth' : 'segYear');
      if (target) target.focus();
    });
  }

  /* Render both cards from ONE resolved state. Neither card computes current
     plan for itself, so "both selected" is not a state this page can reach. */
  function paintPlans(state: string, ent: any): void {
    planStateNow = state;
    const lang: string = window.I18N ? window.I18N.lang() : 'en';

    for (const [planId, badgeId, cardId] of [
      ['free', 'plFreeBadge', 'plFree'],
      ['plus', 'plPlusBadge', 'plPlus'],
    ] as const) {
      const badge = el(badgeId);
      const card = el(cardId);
      const key = planStatusKey(planId, state);
      if (badge) {
        if (key) {
          badge.textContent = key === 'plan.stateEnding'
            ? tx('plan.stateEnding', 'Ending') +
              (formatPeriodEnd(ent && ent.periodEndAt, lang)
                ? ' · ' + formatPeriodEnd(ent && ent.periodEndAt, lang) : '')
            : tx(key, 'Current plan');
          badge.hidden = false;
        } else { badge.hidden = true; }
      }
      if (card) {
        card.classList.toggle('is-current', isCurrentPlan(planId, state));
        card.setAttribute('data-current', isCurrentPlan(planId, state) ? 'true' : 'false');
      }
    }

    /* ── Which of the two Plus cards is "yours" ──────────────────────────
       planStatusKey answers per TIER, and Lifetime and Plus are the same tier,
       so left alone it marks the monthly card as the current plan of somebody
       who paid once. The badge moves to the card they actually bought, and the
       other one drops it: two cards both claiming to be the current plan is
       worse than neither. */
    const onLifetime = isLifetime(ent);
    if (onLifetime) {
      const pb = el('plPlusBadge');
      const lb = el('plLifeBadge');
      const pc = el('plPlus');
      const lc = el('plLife');
      if (pb) pb.hidden = true;
      if (pc) { pc.classList.remove('is-current'); pc.setAttribute('data-current', 'false'); }
      if (lb) { lb.textContent = tx('plans.currentPlan', 'Current plan'); lb.hidden = false; }
      if (lc) { lc.classList.add('is-current'); lc.setAttribute('data-current', 'true'); }
    }

    /* ── The trial timeline ─────────────────────────────────────────────
       Dates are computed here because the subscription does not exist yet:
       there is nothing to read them from until Stripe creates it. That makes
       this OUR arithmetic rather than Stripe's, which is why the sentence says
       "in 7 days, on <date>" instead of presenting the date alone as fact. The
       authoritative date appears on /billing the moment the trial exists. */
    function showTrialPanel(): void {
      const panel = el('plTrial');
      if (!panel) return;
      const annual = interval === 'year';
      const cents = annual ? PLUS_ANNUAL_CENTS : PLUS_MONTHLY_CENTS;
      const price = money(cents) + ' ' +
        (annual ? tx('plans.perYear', '/ year') : tx('plans.perMonth', '/ month'));

      const charge = el('plTrialCharge');
      if (charge) {
        const d = new Date(Date.now() + TRIAL_DAYS * 24 * 60 * 60 * 1000);
        let when = '';
        try {
          when = d.toLocaleDateString(lang, { month: 'long', day: 'numeric' });
        } catch (e) { when = ''; }
        charge.textContent = when
          ? tx('plans.trialCharge', 'Your card is charged {price} in 7 days, on {date}.')
              .replace('{price}', money(cents)).replace('{date}', when)
          : tx('plans.trialCharge', 'Your card is charged {price} in 7 days, on {date}.')
              .replace('{price}', money(cents)).replace(', on {date}', '');
      }
      const sub = el('plTrialSub');
      if (sub) {
        sub.textContent = tx('plans.trialSub', '7 days free, then {price}. Cancel anytime.')
          .replace('{price}', price);
      }
      /* SHIPS `hidden`, and that is asserted, so the reveal cannot simply be a
         class: a hidden element does not transition. Drop the attribute, let
         the browser lay it out once, then open it on the next frame. */
      const wasClosed = panel.hidden;
      panel.hidden = false;
      if (wasClosed) {
        requestAnimationFrame(() => panel.classList.add('is-open'));
      }
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      const go = el('plTrialGo') as HTMLButtonElement | null;
      if (go) {
        go.focus();
        /* Bound once. showTrialPanel can run again when the reader switches
           between monthly and annual, and a second listener would open two
           Checkout Sessions from one click. */
        if (go.dataset.bound !== '1') {
          go.dataset.bound = '1';
          /* The alias is read on click, not captured at bind. Binding it
             would freeze whichever cadence was selected the first time the
             panel opened, and charge annual to somebody looking at monthly. */
          go.addEventListener('click', () => beginCheckout(
            go, interval === 'year' ? 'plus-annual' : 'plus-monthly', 'plTrialErr'));
        }
      }
    }

    /* ── Actually buying ────────────────────────────────────────────────
     * The browser names a PLAN ALIAS and nothing else. Not a Price, not an
     * amount, not a trial length: all three are decided server-side from
     * trusted environment and this account's own eligibility, so a tampered
     * request cannot buy at the wrong price or mint a second trial.
     *
     * Every refusal the action can return is handled by name. A generic "try
     * again" on `already-subscribed` would tell somebody who is already paying
     * that something went wrong, and send them to buy a second subscription. */
    let checkingOut = false;
    async function beginCheckout(btn: HTMLButtonElement, alias: string, errId: string): Promise<void> {
      if (checkingOut) return;
      checkingOut = true;
      const original = btn.textContent || '';
      btn.disabled = true;
      btn.textContent = tx('plans.opening', 'Opening secure checkout…');
      /* Reported on the card that was clicked. One shared error line would put
         "the founding round is full" under the monthly button. */
      const note = el(errId);
      if (note) note.hidden = true;

      const fail = (key: string, fallback: string): void => {
        if (note) { note.textContent = tx(key, fallback); note.hidden = false; }
        btn.disabled = false;
        btn.textContent = original;
        checkingOut = false;
      };

      try {
        /* WIRED, and the guarantee this replaced is worth stating.
         *
         * CLAUDE.md used to promise production was *structurally* incapable of
         * starting a Checkout: the shipped JavaScript could not even NAME
         * createCheckoutSession, and the suites proved it by grepping dist/.
         * That is a guarantee you verify by looking rather than by reasoning.
         *
         * It cannot survive a wired button. Isolating the call in its own
         * module behind `if (!PRICING_ENABLED)` and a dynamic import does not
         * drop it: Rollup will not fold a cross-module const to prove the
         * import unreachable, so the chunk ships either way. Verified, not
         * assumed.
         *
         * OVERRIDDEN BY THE OWNER, 2026-08-26, and replaced with properties
         * that are still checkable rather than with nothing:
         *   1. PRICING_ENABLED ships false
         *   2. the CTA ships `disabled` in the built markup
         *   3. the trial panel ships `hidden`
         *   4. checkout-start.js is NEVER imported statically, so it is not in
         *      any page's initial bundle
         *   5. this early return makes the call unreachable while the flag is
         *      false, before any network work happens
         *   6. the browser may name a plan ALIAS and nothing else: no Price, no
         *      amount, no trial length
         * All six are asserted. CLAUDE.md is updated to say this rather than
         * the thing that is no longer true. */
        if (!PRICING_ENABLED) return fail('plans.errUnavailable', 'We could not open checkout just now. Please try again.');
        const { startCheckout } = await import('../app/declare/checkout-start.js');
        const res = await startCheckout(alias, lang === 'es' ? 'es' : undefined);

        /* NULL IS UNKNOWN, NEVER SUCCESS. Treating it as success sends somebody
           to a blank page believing they bought something. */
        if (!res) return fail('plans.errUnavailable', 'We could not open checkout just now. Please try again.');

        if (res.error) {
          if (res.error === 'already-subscribed') {
            return fail('plans.errAlready', 'You already have Plus on this account. Open Billing to manage it.');
          }
          if (res.error === 'lifetime-sold-out') {
            /* The round filled while this page was open. Record it and repaint
               so the button stops inviting a purchase that will refuse again,
               and say plainly that monthly and annual are still there. */
            seatsSoldOut = true;
            fail('plans.errSeatsGone', 'The last founding seat went while you were reading. Monthly and annual are still open.');
            paintLifetime(state, false);
            return;
          }
          if (res.error === 'not-authenticated') {
            /* Not an error to explain, a step to take. */
            window.location.href = '/create-account';
            return;
          }
          return fail('plans.errUnavailable', 'We could not open checkout just now. Please try again.');
        }

        if (!res.url) return fail('plans.errUnavailable', 'We could not open checkout just now. Please try again.');

        track('checkout_opened', {
          authenticated: true,
          selected_interval: alias === 'plus-lifetime' ? 'lifetime' : interval,
          plan_alias: alias,
          displayed_tier: currentPlanId(state) || 'none',
        });
        /* assign, not replace: leaving /pricing in history means backing out of
           Stripe returns here rather than to whatever preceded it. */
        window.location.assign(res.url);
      } catch (e) {
        fail('plans.errUnavailable', 'We could not open checkout just now. Please try again.');
      }
    }

    /* Free card action. A person already on Free is not sold Free again. */
    const fCta = el('plFreeCta');
    if (fCta) {
      const intent = freeCtaIntent(state);
      fCta.innerHTML = '';
      if (intent === 'create-account') {
        const a = document.createElement('a');
        a.className = 'btn btn-ghost'; a.href = '/create-account';
        a.textContent = tx('plans.freeCreate', 'Create a free account');
        fCta.appendChild(a);
      } else if (intent === 'current') {
        const s = document.createElement('span');
        s.className = 'btn btn-quiet'; s.setAttribute('aria-disabled', 'true');
        s.textContent = tx('plans.currentPlan', 'Current plan');
        fCta.appendChild(s);
      }
    }

    /* Plus card action, by intent. A subscriber never sees a purchase control,
       enabled or not — they get the management action their state calls for. */
    const pCta = el('plPlusCta');
    if (pCta) {
      const intent = plusCtaIntent(state, PRICING_ENABLED);
      pCta.innerHTML = '';
      if (intent === 'launches-soon' || intent === 'upgrade') {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'btn btn-primary'; b.id = 'plPlusBtn';
        if (intent === 'launches-soon') {
          b.disabled = true;
          b.textContent = tx('plans.launchSoon', 'Plus launches soon');
        } else {
          /* THE TRIAL IS THE OFFER, so the button says so. "Upgrade to Plus"
             asks for money; this asks for seven days. */
          b.textContent = tx('plans.startTrial', 'Start my 7 days free');
          b.addEventListener('click', () => {
            track('upgrade_cta_selected', {
              authenticated: state !== 'guest',
              displayed_tier: currentPlanId(state) || 'none',
              selected_interval: interval,
              pricing_enabled: PRICING_ENABLED,
            });
            /* Reveal the timeline rather than going straight to Stripe. One
               extra tap, and it is the tap that tells them the date they will
               be charged and the day we will write to them. */
            showTrialPanel();
          });
        }
        pCta.appendChild(b);
      } else if (intent !== 'none') {
        const a = document.createElement('a');
        a.className = 'btn btn-ghost'; a.href = '/billing';
        a.textContent = intent === 'update-payment'
          ? tx('plan.updatePayment', 'Update payment')
          : intent === 'keep-plus'
            ? tx('plan.keepPlus', 'Keep Plus')
            : tx('plan.manage', 'Manage billing');
        a.addEventListener('click', () => {
          track('manage_billing_selected', {
            authenticated: true,
            displayed_tier: 'plus',
            presentation: state,
            source: 'plans',
          });
        });
        pCta.appendChild(a);
      }
    }

    /* The lifecycle sentence, only when it is not simply active. */
    const life = el('plPlusLife');
    if (life) {
      const MSG: Record<string, string> = {
        'plus-cancelling': 'plan.cancellingMsg',
        'plus-attention': 'plan.attentionMsg',
        'plus-ambiguous': 'plan.ambiguousMsg',
      };
      const k = MSG[state];
      if (k) { life.textContent = tx(k, ''); life.hidden = false; }
      else { life.hidden = true; }
    }

    startLifetimeCheckout = (b) => beginCheckout(b, 'plus-lifetime', 'plLifeErr');
    paintLifetime(state, onLifetime);

    /* Belt and braces: a subscriber must never reach a purchase control. */
    if (!mayStartCheckout(state)) {
      const b = el('plPlusBtn');
      if (b instanceof HTMLButtonElement) { b.disabled = true; }
      /* paintLifetime already renders nothing for a state that may not buy.
         This is the second lock: if one is ever loosened the other still holds. */
      const l = el('plLifeBtn');
      if (l instanceof HTMLButtonElement) { l.disabled = true; }
    }
  }

  /* ── THE FOUNDING ROUND ───────────────────────────────────────────────────
   *
   * Three things decide this button, and all three must say yes: purchasing is
   * on, this reader may start a checkout at all, and the round still has room.
   *
   * SOLD OUT IS A SEPARATE SENTENCE from "launches soon". Both leave the button
   * disabled, and a reader who cannot tell which one applies to them will read
   * the wrong one as the reason they cannot buy.
   *
   * A LIFETIME HOLDER IS NOT SHOWN A SOLD-OUT ROUND. They are in it. The card
   * carries their badge instead, and the button is suppressed by
   * mayStartCheckout like every other purchase control on this page. */
  /* paintPlans owns the checkout, because it is the only scope that knows the
     resolved state and language. The Lifetime card is painted from outside that
     scope, so the two meet here rather than by hoisting a function that would
     then need both passed back in. Null until the first paint, which is the
     correct answer: before state resolves, nothing on this page may buy. */
  let startLifetimeCheckout: ((btn: HTMLButtonElement) => void) | null = null;
  let seatsSoldOut = false;
  function paintLifetime(state: string, onLifetime: boolean): void {
    /* The price is painted from the shared constant even though the markup
       already carries it, exactly as the Plus card does. The markup figure is
       the pre-script default; plan-display.js is the definition. Without this
       the constant would be imported and unused, the bundler would drop it,
       and $149 would quietly have only one home again: this file. */
    const lifeAmt = el('plLifeAmt');
    if (lifeAmt) lifeAmt.textContent = moneyRound(PLUS_LIFETIME_CENTS);

    const cta = el('plLifeCta');
    if (!cta) return;

    /* THE SAME INTENT THE PLUS CARD USES, deliberately.
     *
     * The two cards sell the same tier, so they must agree about whether this
     * reader may be sold anything at all. Asking plusCtaIntent rather than
     * re-deriving it here is what makes that structural instead of a habit.
     *
     * It also fixes something the static markup got wrong. Free and Plus build
     * their controls from script, so an unresolved read leaves them with no
     * button. Lifetime's button was in the markup, so it survived, and the
     * page fell back to a state where the ONLY visible control sat on the
     * $149 card. Rendered from the same intent, it now disappears with them. */
    const intent = plusCtaIntent(state, PRICING_ENABLED);
    cta.innerHTML = '';

    /* Already a founding member. Stated, not sold, and in the same quiet
       treatment the Free card uses for the plan somebody is already on. */
    if (onLifetime) {
      const chip = document.createElement('span');
      chip.className = 'btn btn-quiet'; chip.setAttribute('aria-disabled', 'true');
      chip.textContent = tx('plans.currentPlan', 'Current plan');
      cta.appendChild(chip);
      return;
    }
    /* A subscriber is not offered Lifetime on top. The server would allow it,
       and today that would leave them paying monthly AND holding lifetime,
       because cancelling the subscription on a lifetime purchase is not built
       yet. Until it is, the honest control is no control. */
    if (intent !== 'launches-soon' && intent !== 'upgrade') return;

    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'btn btn-primary'; btn.id = 'plLifeBtn';

    if (intent === 'launches-soon') {
      btn.disabled = true;
      btn.textContent = tx('plans.launchSoon', 'Plus launches soon');
    } else if (seatsSoldOut) {
      /* A DIFFERENT SENTENCE from "launches soon", and that is the point. Both
         leave the button dead, and a reader shown the wrong one is told the
         wrong reason they cannot buy. */
      btn.disabled = true;
      btn.textContent = tx('plans.lifeSoldOut', 'The founding round is full');
    } else {
      btn.textContent = tx('plans.lifeCta', 'Become a founding member');
      btn.addEventListener('click', () => {
        track('upgrade_cta_selected', {
          authenticated: planStateNow !== 'guest',
          displayed_tier: currentPlanId(planStateNow) || 'none',
          selected_interval: 'lifetime',
          pricing_enabled: PRICING_ENABLED,
        });
        if (startLifetimeCheckout) startLifetimeCheckout(btn);
      });
    }
    cta.appendChild(btn);
  }

  /* The seat total, and whether the round is open, from the server.
   *
   * NEVER TYPED INTO THIS PAGE. convex/plusPlans.ts holds the cap that actually
   * refuses a purchase; a second copy here is a promise that can drift from the
   * rule. A failed read leaves the bullet hidden and the round open, because
   * the server refuses a sold-out purchase regardless of what this says. */
  async function loadSeats(state: string, onLifetime: boolean): Promise<void> {
    let info: any = null;
    try { info = await lifetimeAvailability(); } catch (e) { info = null; }
    if (!info || typeof info.seats !== 'number') return;
    seatsSoldOut = info.soldOut === true;
    const li = el('plLifeSeats');
    if (li) {
      li.textContent = tx('plans.lifeSeats', '{seats} founding seats in this round')
        .replace('{seats}', String(info.seats));
      li.hidden = false;
    }
    paintLifetime(state, onLifetime);
  }


  /* ── DEVELOPMENT-ONLY STATE PREVIEW ──────────────────────────────────────
     Renders this page against a fixed entitlement fixture so every plan state
     can be reviewed and screenshotted without a real subscription, a Test
     Clock or a Stripe object.

     Gated exactly the way the Journey pacing-lock bypass and the billing dev
     control are, and for the same reason: `import.meta.env.DEV` is FALSE in
     every `astro build`, so Vite folds this to `if (false)` and esbuild drops
     the body — including the fixtures. The public flag alone would not be a
     gate, because Vite loads .env.local in production builds too. Both halves
     are required, and the build output is asserted to contain neither.

     No route is added and no mock data is deployed. */
  function previewEntitlement(): any | undefined {
    if (!(import.meta.env.DEV && import.meta.env.PUBLIC_PLANS_PREVIEW === '1')) return undefined;
    const want = new URLSearchParams(location.search).get('preview');
    if (!want) return undefined;
    const END = Date.parse('2028-08-23T12:00:00Z');
    const F: Record<string, any> = {
      guest: { tier: 'guest' },
      free: { tier: 'free', subscriptionStatus: 'none',
              remaining: { gentleGuidanceToday: 3, activeJourneySlots: 3 } },
      plusMonthly: { tier: 'plus', subscriptionStatus: 'active', billingInterval: 'month',
              cancelAtPeriodEnd: false, paymentNeedsAttention: false, periodEndAt: END },
      plusAnnual: { tier: 'plus', subscriptionStatus: 'active', billingInterval: 'year',
              cancelAtPeriodEnd: false, paymentNeedsAttention: false, periodEndAt: END },
      attention: { tier: 'plus', subscriptionStatus: 'past_due', billingInterval: 'year',
              cancelAtPeriodEnd: false, paymentNeedsAttention: true, periodEndAt: END },
      ending: { tier: 'plus', subscriptionStatus: 'active', billingInterval: 'year',
              cancelAtPeriodEnd: true, paymentNeedsAttention: false, periodEndAt: END },
    };
    return F[want];
  }

  /* The thumb is measured, so it has to be re-measured whenever the thing it
     measures can change: after the web fonts land and on any resize. Cheap, and
     the alternative is a pill that sits beside its option rather than under it. */
  addEventListener('resize', moveThumb);
  if ((document as any).fonts && (document as any).fonts.ready) {
    (document as any).fonts.ready.then(moveThumb).catch(() => {});
  }

  (async () => {
    paintCadence();
    let ent: any = previewEntitlement();
    if (ent === undefined) { try { ent = await myEntitlements(); } catch (e) { ent = null; } }
    const state = planState(ent);
    /* A subscriber's own cadence, so the page never prices someone else's plan. */
    setInterval2(initialInterval(ent, state), false);
    paintCadence();
    paintPlans(state, ent);
    /* Not awaited. The three cards are already correct without it; the seat
       bullet and a sold-out round are the only things it can change, and
       neither is worth holding the page for. */
    void loadSeats(state, isLifetime(ent));
    track('plans_viewed', {
      authenticated: state !== 'guest' && state !== 'loading',
      displayed_tier: currentPlanId(state) || 'none',
      selected_interval: interval,
      presentation: state,
      pricing_enabled: PRICING_ENABLED,
    });
  })();
</script>

  <style is:global>
    .plans { position: relative; min-height: 100dvh; }
    .plans .in { position: relative; z-index: 1; max-width: 940px; margin: 0 auto; padding: 0 20px 120px; }
    .plans .sub-top { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 12px 0 0; }
    .plans .sub-top .ttl { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
    .plans .iconbtn { width: 44px; height: 44px; border-radius: 50%; border: 0; background: transparent; color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .plans .iconbtn svg { width: 20px; height: 20px; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

    .plans .pl-hero { text-align: center; padding: 22px 0 26px; }
    .plans .pl-hero h1 { font-family: 'Cormorant Garamond', serif; font-size: 34px; line-height: 1.14; color: var(--text); font-weight: 500; max-width: 18ch; margin: 0 auto; }
    .plans .pl-sub { font-size: 14.5px; line-height: 1.65; color: var(--muted); margin: 14px auto 0; max-width: 46ch; }

    /* Cadence — a calm segmented control, never a neon toggle. */
    .plans .pl-cadence { display: flex; justify-content: center; margin-bottom: 22px; }
    .plans .seg { position: relative; display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
    /* The moving pill. Sits behind the labels, is positioned by script, and
       starts invisible so it cannot flash at 0,0 before it is measured. */
    .plans .seg-thumb { position: absolute; left: 4px; top: 4px; bottom: 4px; width: 0; opacity: 0;
      border-radius: 999px; pointer-events: none; z-index: 0;
      background: color-mix(in srgb, var(--gold) 14%, transparent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gold) 38%, transparent);
      transition: transform .34s cubic-bezier(.2,.72,.2,1), width .34s cubic-bezier(.2,.72,.2,1), opacity .2s ease; }
    .plans .seg-o { position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 14px; font-weight: 600; cursor: pointer; transition: color .18s ease; }
    /* The selected option paints its own background by default, so the control
       is still legible with no script at all. The thumb takes that job over
       only once it has actually been measured, which is what .has-thumb says. */
    .plans .seg-o.is-on { color: var(--text); background: color-mix(in srgb, var(--gold) 14%, transparent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--gold) 38%, transparent); }
    .plans .seg.has-thumb .seg-o.is-on { background: transparent; box-shadow: none; }
    .plans .seg-o:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .plans .seg-save { font-size: 11px; font-weight: 700; letter-spacing: .04em; color: var(--goldd); }

    .plans .pl-grid { display: grid; gap: 16px; }
    .plans .pl-card { position: relative; display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 26px 22px;
      transition: transform .3s cubic-bezier(.2,.72,.2,1), border-color .3s ease, box-shadow .3s ease; }
    /* Pointer only. On a touch screen :hover sticks after a tap, so a card the
       reader scrolled past stays lifted. */
    @media (hover: hover) and (pointer: fine) {
      .plans .pl-card:hover { transform: translateY(-3px); }
      .plans .pl-card:hover:not(.pl-once) { border-color: color-mix(in srgb, var(--gold) 34%, var(--line)); }
    }
    /* Plus carries slightly more weight, but restrained: a warmer border and a
       whisper of gold, never a gradient. */
    .plans .pl-plus { border-color: color-mix(in srgb, var(--gold) 46%, var(--line)); }

    /* ── Lifetime ────────────────────────────────────────────────────────
       Deliberately a different surface, not a third variation of the same one.
       Lifetime is bought once and the cadence control above does not price it,
       so making it look like a third column would invite exactly the wrong
       comparison.

       Built from the SAME tokens as everything else, which is what makes it
       work in both themes without a second set of colours: the ink is the
       theme's own deep ground, and the type on it is the theme's own light
       text. In light mode that is a dark card on cream. In dark mode it is a
       deeper card on an already dark page, and the gold hairline is what keeps
       its edge readable. */
    .plans .pl-once {
      background:
        radial-gradient(120% 100% at 50% -20%, color-mix(in srgb, var(--gold) 12%, transparent), transparent 62%),
        linear-gradient(168deg, #2B4739 0%, #1B2E26 100%);
      /* Quieter than the Plus card's border on purpose. The fill is already
         doing the separating, and two cards wearing the same gold edge is two
         cards claiming to be the recommended one. */
      border-color: color-mix(in srgb, var(--gold) 22%, #1B2E26);
      color: #F3EFE6;
    }
    .plans .pl-once .pl-nm { color: #F7F3E8; }
    .plans .pl-once .pl-desc,
    .plans .pl-once .pl-cur,
    .plans .pl-once .pl-per { color: #B9C9BD; }
    .plans .pl-once .pl-amt { color: #F7F3E8; }
    .plans .pl-once .pl-list li { color: #DCE5DD; }
    .plans .pl-once .pl-list li::before { border-color: #D8B85F; }
    .plans .pl-once .pl-fine { color: #9FB2A4; }
    .plans .pl-once .pl-badge { color: #2A2208; background: #D8B85F; border-color: #D8B85F; }
    .plans .pl-once .pl-trial-err { color: #F3EFE6; border-left-color: rgba(216,184,95,.55); }
    /* Gold, because on this ground the forest primary would disappear into the
       card. The only button on the page that is not var(--gold) adjacent. */
    .plans .pl-once .btn-primary { background: #D8B85F; color: #26200A; border: 1px solid #D8B85F; }
    /* A dead control has to look dead. Solid gold at 55% opacity still reads as
       the page's primary action, and here it would be the loudest thing on the
       screen sitting on the most expensive card. Disabled drops to an outline. */
    .plans .pl-once .btn-primary[disabled] { background: transparent; color: #9FB2A4;
      border-color: rgba(216,184,95,.32); opacity: 1; }
    .plans .pl-once .btn-primary:not([disabled]):hover { background: #E2C572; }
    .plans .pl-once .btn-primary:focus-visible { outline: 2px solid #F3EFE6; outline-offset: 2px; }
    @media (hover: hover) and (pointer: fine) {
      .plans .pl-once:hover { border-color: color-mix(in srgb, var(--gold) 46%, #1B2E26); }
    }

    /* The absence of a trial, said on the card rather than discovered at
       checkout. Quiet: it is a clarification, not a warning. */
    .plans .pl-fine { font-size: 11.5px; line-height: 1.5; margin: 18px 0 0;
      color: var(--muted); text-align: center; }
    /* The current plan is stated calmly. Colour is never the only signal —
       the badge carries the word. */
    .plans .pl-card.is-current { border-color: var(--gold); box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 26%, transparent); }
    .plans .pl-badge { align-self: flex-start; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; margin-bottom: 12px; color: var(--goldd); border: 1px solid color-mix(in srgb, var(--gold) 42%, var(--line2)); background: color-mix(in srgb, var(--gold) 10%, transparent); }
    .plans .pl-nm { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 500; color: var(--text); margin: 0; }
    .plans .pl-desc { font-size: 13.5px; line-height: 1.6; color: var(--muted); margin: 6px 0 0; min-height: 2.6em; }
    .plans .pl-price { display: flex; align-items: baseline; gap: 5px; margin-top: 16px; }
    .plans .pl-amt { font-family: 'Cormorant Garamond', serif; font-size: 44px; line-height: 1; color: var(--text);
      font-variant-numeric: tabular-nums; }
    /* A figure that just changed says so once. Short and small on purpose: a
       price that bounces reads as a sales trick, and this page is asking to be
       believed. */
    .plans .pl-amt.is-swap { animation: plSwap .34s cubic-bezier(.2,.72,.2,1); }
    @keyframes plSwap {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: none; }
    }
    .plans .pl-cur { font-size: 13.5px; color: var(--muted); }
    .plans .pl-per { font-size: 12.5px; color: var(--muted); margin-top: 6px; min-height: 1.4em; }
    .plans .pl-list { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 11px; flex: 1; }
    .plans .pl-list li { position: relative; padding-left: 24px; font-size: 14px; line-height: 1.5; color: var(--text2); }
    .plans .pl-list li::before { content: ''; position: absolute; left: 4px; top: 6px; width: 9px; height: 5px; border-left: 1.8px solid var(--gold); border-bottom: 1.8px solid var(--gold); transform: rotate(-45deg); }
    .plans .pl-cta { margin-top: 22px; }
    .plans .pl-cta .btn { width: 100%; min-height: 48px; display: inline-flex; align-items: center; justify-content: center; }
    .plans .pl-cta .btn[disabled], .plans .pl-cta .btn[aria-disabled="true"] { opacity: .55; cursor: not-allowed; }
    .plans .btn-quiet { border: 1px solid var(--line); border-radius: 14px; background: transparent; color: var(--muted); font-size: 15px; font-weight: 600; }
    /* The Plus card's lifecycle sentence. NOT the Lifetime card: that is
       .pl-once. The two were both called .pl-life for a few minutes, and this
       rule silently applied its type and its 12px top margin to the whole
       Lifetime card, which is why that card came out 12px shorter than the
       other two in a grid that was explicitly told to stretch. */
    .plans .pl-life { font-size: 12.5px; line-height: 1.55; color: var(--muted); margin: 12px 0 0; }

    /* Comparison — a real table on desktop, stacked rows on mobile. */
    .plans .pl-cmp { margin-top: 40px; }
    .plans .pl-cmp-h { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 500; color: var(--text); margin: 0 0 16px; text-align: center; }
    .plans .pl-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .plans .pl-table th, .plans .pl-table td { padding: 14px 12px; text-align: left; border-bottom: 1px solid var(--line); }
    .plans .pl-table thead th { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
    .plans .pl-table tbody th { font-weight: 500; color: var(--text2); }
    .plans .pl-table td { color: var(--text2); }
    .plans .pl-table thead th:nth-child(3), .plans .pl-table td:nth-child(3) { color: var(--text); }

    .plans .pl-cmp-note { font-size: 12.5px; line-height: 1.6; color: var(--muted);
      margin: 14px 0 0; text-align: center; }

    .plans .pl-trust { list-style: none; margin: 30px auto 0; padding: 0; display: grid; gap: 8px; max-width: 46ch; text-align: center; }
    .plans .pl-trust li { font-size: 12.5px; line-height: 1.6; color: var(--muted); }

    /* Crisis help. Quiet by design: this is a signpost for somebody who needs
       it, not a promotion. It must not compete with the plans above it, and it
       must not look like a third tier. */
    /* The trial timeline. Quiet and structural: this is a statement of what
       will happen to the reader, not a sales panel. The numbers carry the
       hierarchy, so nothing else needs to shout. */
    .plans .pl-trial { margin: 16px 0 0; padding: 18px 18px 16px;
      border: 1px solid var(--line2); border-radius: 12px; text-align: left;
      opacity: 0; transform: translateY(-6px);
      transition: opacity .32s ease, transform .32s cubic-bezier(.2,.72,.2,1); }
    .plans .pl-trial.is-open { opacity: 1; transform: none; }
    .plans .pl-trial-h { font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 18px; font-weight: 600; margin: 0 0 14px; color: var(--text); }
    .plans .pl-trial-steps { list-style: none; margin: 0; padding: 0;
      display: grid; gap: 13px; counter-reset: none; }
    .plans .pl-trial-steps li { display: grid; gap: 2px; }
    .plans .pl-trial-steps strong { font-size: 13.5px; font-weight: 600; color: var(--text); }
    .plans .pl-trial-steps span { font-size: 12.5px; line-height: 1.55; color: var(--muted); }
    .plans .pl-trial-err { margin: 0 0 12px; font-size: 12.5px; line-height: 1.5;
      color: var(--text); border-left: 2px solid var(--line2); padding-left: 10px; }
    .plans .pl-trial-sub { margin: 15px 0 13px; font-size: 12.5px;
      line-height: 1.5; color: var(--muted); }

    .plans .pl-help { margin: 38px auto 0; padding: 20px 22px; max-width: 46ch;
      border: 1px solid var(--line2); border-radius: 12px; text-align: center; }
    .plans .pl-help-h { font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 19px; font-weight: 600; margin: 0 0 8px; color: var(--text); }
    .plans .pl-help-d { font-size: 13.5px; line-height: 1.65; margin: 0 0 14px;
      color: var(--muted); }
    .plans .pl-help-a { display: inline-block; font-size: 14px; font-weight: 600;
      color: var(--text); border-bottom: 1px solid currentColor; padding-bottom: 2px; }
    .plans .pl-help-a:focus-visible { outline: 2px solid var(--text2); outline-offset: 4px; }

    .plans .pl-faq { margin-top: 44px; }
    .plans .pl-q { border-bottom: 1px solid var(--line); }
    .plans .pl-q summary { list-style: none; cursor: pointer; padding: 16px 0; font-size: 14.5px; color: var(--text); min-height: 44px; display: flex; align-items: center; }
    .plans .pl-q summary::-webkit-details-marker { display: none; }
    .plans .pl-q summary::after { content: '+'; margin-left: auto; color: var(--goldd); font-size: 18px; }
    .plans .pl-q[open] summary::after { content: '\2013'; }
    .plans .pl-q summary:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .plans .pl-q p { font-size: 13.5px; line-height: 1.7; color: var(--muted); margin: 0 0 16px; max-width: 60ch; }


    /* Two up before three. At 760px a third column would give each card about
       230px, which is narrower than its own price. */
    @media (min-width: 760px) {
      .plans .pl-grid { grid-template-columns: 1fr 1fr; align-items: stretch; gap: 20px; }
      .plans .pl-hero h1 { font-size: 40px; }
    }
    @media (min-width: 1000px) {
      .plans .in { max-width: 1060px; }
      .plans .pl-grid { grid-template-columns: repeat(3, 1fr); align-items: stretch; gap: 18px; }
    }
    @media (max-width: 620px) {
      .plans .pl-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
      .plans .pl-table tr { display: block; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .plans .pl-table th, .plans .pl-table td { display: block; border: 0; padding: 2px 0; }
      .plans .pl-table tbody th { font-size: 14px; color: var(--text); margin-bottom: 4px; }
      .plans .pl-table td { font-size: 13px; color: var(--muted); padding-left: 0; }
      .plans .pl-table td::before { content: attr(data-lbl) ' '; color: var(--muted); }
    }
    /* Every animation added for this page is listed here, not just the ones
       that felt lively. A reader who asked the system for less motion asked for
       all of it, including the ones that are only a few pixels. */
    @media (prefers-reduced-motion: reduce) {
      .plans .seg-o,
      .plans .seg-thumb,
      .plans .pl-card,
      .plans .pl-trial { transition: none; }
      .plans .pl-amt.is-swap { animation: none; }
      .plans .pl-card:hover { transform: none; }
      .plans .pl-trial { opacity: 1; transform: none; }
    }
  </style>
</DeclareLayout>
