# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# Cloudflare Worker local secrets — never commit the real key
worker/.dev.vars

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
worker/.wrangler/
.claude/settings.local.json
.impeccable/

.env.local

# local working files
/*.pdf

# Local Playwright MCP browser artifacts
.playwright-mcp/

# Vite loads this ONLY in dev mode, unlike .env.local which loads in
# production builds too. It is where the billing dev-control flag and any
# local Convex overrides belong. Never commit one.
.env.development.local
